---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
---

<header
  class="site-header sticky top-0 z-50 w-full bg-white/90 backdrop-blur-xl backdrop-saturate-150 transition-all duration-300"
  id="site-header"
>
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 lg:px-8">
    <!-- Logo -->
    <a href="/" class="group flex items-center gap-3">
      <img
        src="/images/logo.png"
        alt={business.name}
        class="h-11 w-auto transition-transform duration-300 group-hover:scale-105"
        width="730"
        height="730"
      />
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden items-center gap-0.5 xl:flex">
      {[
        { href: '/', label: 'Home' },
        { href: '/about/', label: 'About Us' },
        { href: '/services/', label: 'Services' },
        { href: '/blog/', label: 'Insights' },
        { href: '/areas/', label: 'Locations' },
        { href: '/contact/', label: 'Contact Us' },
      ].map((link) => (
        <a
          href={link.href}
          class="rounded-lg px-4 py-2 text-sm font-medium text-neutral-600 transition-all duration-200 hover:bg-brand-50 hover:text-brand-700"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Right side actions -->
    <div class="flex items-center gap-3">
      <a
        href="/contact/"
        class="gradient-cta hidden sm:inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5"
      >
        Get Free Consultation
        <Icon name="lucide:arrow-right" class="size-4" />
      </a>
      <a
        href="/contact/"
        class="gradient-cta inline-flex sm:hidden size-10 items-center justify-center rounded-xl text-white transition-all"
      >
        <Icon name="lucide:mail" class="size-4" />
      </a>

      <!-- Mobile menu button -->
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-xl text-neutral-500 transition-colors hover:bg-neutral-100 hover:text-neutral-700 xl:hidden"
        aria-label="Toggle menu"
        id="mobile-menu-btn"
      >
        <Icon name="lucide:menu" class="size-5" id="menu-icon-open" />
        <Icon name="lucide:x" class="hidden size-5" id="menu-icon-close" />
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="hidden border-t border-neutral-100 bg-white xl:hidden" id="mobile-menu">
    <nav class="mx-auto max-w-7xl space-y-1 px-5 py-4">
      {[
        { href: '/', label: 'Home', icon: 'lucide:home' },
        { href: '/about/', label: 'About Us', icon: 'lucide:info' },
        { href: '/services/', label: 'Services', icon: 'lucide:target' },
        { href: '/blog/', label: 'Insights', icon: 'lucide:book-open' },
        { href: '/areas/', label: 'Locations', icon: 'lucide:map-pin' },
        { href: '/contact/', label: 'Contact Us', icon: 'lucide:mail' },
      ].map((link) => (
        <a
          href={link.href}
          class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium text-neutral-700 transition-colors hover:bg-brand-50 hover:text-brand-700"
        >
          <Icon name={link.icon} class="size-5 text-brand-500" />
          {link.label}
        </a>
      ))}
      <div class="pt-3">
        <a
          href="/contact/"
          class="gradient-cta flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white transition-all"
        >
          Get Free Consultation
          <Icon name="lucide:arrow-right" class="size-4" />
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });

  const header = document.getElementById('site-header');
  window.addEventListener(
    'scroll',
    () => {
      if (window.scrollY > 8) {
        header?.classList.add('shadow-sm');
      } else {
        header?.classList.remove('shadow-sm');
      }
    },
    { passive: true },
  );
</script>
