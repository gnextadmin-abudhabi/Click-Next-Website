---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';
import { serviceUrl, areaUrl } from '../lib/urls';
---

<footer class="relative overflow-hidden text-white">
  <!-- Abstract gradient background -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-neutral-950 via-brand-950 to-neutral-950">
    <div class="absolute -top-40 -right-40 size-[600px] rounded-full bg-brand-600/10 blur-[120px]" />
    <div class="absolute -bottom-20 left-1/4 size-[500px] rounded-full bg-brand-700/8 blur-[100px]" />
    <div class="absolute top-1/2 right-1/3 size-[300px] rounded-full bg-brand-500/5 blur-3xl" />
    <div class="absolute bottom-10 right-10 size-[200px] rounded-full bg-brand-400/5 blur-2xl" />
    <!-- Subtle grid -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(124,58,237,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(124,58,237,0.03)_1px,transparent_1px)] bg-[size:48px_48px]" />
  </div>

  <!-- Subtle top border gradient -->
  <div class="relative h-px w-full bg-gradient-to-r from-transparent via-brand-400/40 to-transparent" />

  <div class="relative mx-auto max-w-7xl px-5 pb-12 pt-20 lg:px-8 lg:pt-24">
    <!-- Top section: Logo + tagline -->
    <div class="flex flex-col items-center text-center lg:flex-col lg:items-center lg:text-left">
      <a href="/" class="group inline-flex items-center gap-4">
        <img
          src="/images/logo-white.png"
          alt={business.name}
          class="h-12 w-auto transition-transform duration-300 group-hover:scale-105"
          width="730"
          height="730"
        />
      </a>
      <p class="mt-5 max-w-md text-sm leading-relaxed text-neutral-400 lg:mx-0">
        {business.tagline} Data-driven performance marketing for businesses across the UAE. Part of the GNEXT group of digital companies.
      </p>
    </div>

    <!-- Link columns -->
    <div class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      <!-- Services column -->
      <div>
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-wider text-neutral-500">
          Services
        </h3>
        <div class="grid gap-2.5">
          {serviceTypes.map((service) => (
            <a
              href={serviceUrl(service.slug)}
              class="text-sm text-neutral-400 transition-all duration-200 hover:text-white hover:translate-x-0.5 inline-block"
            >
              {service.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Locations column -->
      <div>
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-wider text-neutral-500">
          Locations
        </h3>
        <div class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-1">
          {serviceAreas.map((area) => (
            <a
              href={areaUrl(area.slug)}
              class="text-sm text-neutral-400 transition-all duration-200 hover:text-white hover:translate-x-0.5 inline-block"
            >
              {area.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Company column -->
      <div>
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-wider text-neutral-500">
          Company
        </h3>
        <div class="grid gap-2.5">
          <a href="/" class="text-sm text-neutral-400 transition-all duration-200 hover:text-white hover:translate-x-0.5 inline-block">Home</a>
          <a href="/about/" class="text-sm text-neutral-400 transition-all duration-200 hover:text-white hover:translate-x-0.5 inline-block">About Us</a>
          <a href="/contact/" class="text-sm text-neutral-400 transition-all duration-200 hover:text-white hover:translate-x-0.5 inline-block">Contact Us</a>
          <a href="/blog/" class="text-sm text-neutral-400 transition-all duration-200 hover:text-white hover:translate-x-0.5 inline-block">Insights</a>
        </div>
      </div>

      <!-- Contact + Sister Brands -->
      <div>
        <h3 class="mb-5 text-xs font-semibold uppercase tracking-wider text-neutral-500">
          Contact
        </h3>
        <ul class="space-y-3">
          <li>
            <a href={`tel:${business.phoneTel}`} class="text-sm text-neutral-400 transition-colors hover:text-white">{business.phone}</a>
          </li>
          <li>
            <a href={`mailto:${business.email}`} class="text-sm text-neutral-400 transition-colors hover:text-white">{business.email}</a>
          </li>
          <li class="text-sm text-neutral-400">
            {business.address.city}, UAE
          </li>
        </ul>

        <!-- Sister Brands -->
        <div class="mt-6 pt-6 border-t border-white/8">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 mb-3">GNEXT Group</p>
          <div class="flex flex-col gap-2">
            <a href="https://GNEXT.ae/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-neutral-400 transition-all hover:text-white">
              <span class="inline-flex size-2 rounded-full bg-emerald-400"></span>
              GNEXT — Web Solutions
            </a>
            <a href="https://GXLOCATE.com/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-neutral-400 transition-all hover:text-white">
              <span class="inline-flex size-2 rounded-full bg-blue-400"></span>
              GXLOCATE — Local Intelligence
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="relative mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/8 pt-8 sm:flex-row">
      <p class="text-xs text-neutral-500">
        &copy; {new Date().getFullYear()} CLICKNX. All rights reserved. A GNEXT Group Company.
      </p>
      <div class="flex gap-6 text-xs text-neutral-500">
        <a href="https://GNEXT.ae/" target="_blank" rel="noopener" class="transition-colors hover:text-white">GNEXT</a>
        <a href="https://GXLOCATE.com/" target="_blank" rel="noopener" class="transition-colors hover:text-white">GXLOCATE</a>
        <span>{business.address.city}, UAE</span>
      </div>
    </div>
  </div>
</footer>
