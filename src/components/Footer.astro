---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';
import { serviceUrl, areaUrl } from '../lib/urls';

const companyLinks = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Locations', href: '/areas/' },
  { label: 'Insights', href: '/blog/' },
  { label: 'Contact Us', href: '/contact/' },
];

const groupCompanies = [
  { label: 'GNEXT', note: 'Web Solutions', href: 'https://GNEXT.ae/', dot: 'bg-emerald-400' },
  { label: 'GXLOCATE', note: 'Local Intelligence', href: 'https://GXLOCATE.com/', dot: 'bg-sky-400' },
];

const linkClass = 'text-sm text-neutral-400 transition-colors duration-200 hover:text-white';
const headingClass = 'text-xs font-semibold uppercase tracking-[0.14em] text-neutral-500';

const socialLinks = [
  { label: 'Facebook', icon: 'lucide:facebook', href: business.socialMedia.facebook },
  { label: 'Instagram', icon: 'lucide:instagram', href: business.socialMedia.instagram },
  { label: 'LinkedIn', icon: 'lucide:linkedin', href: business.socialMedia.linkedin },
].filter((link) => link.href);
---

<footer class="relative overflow-hidden text-white">
  <!-- background -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-neutral-950 via-brand-950 to-neutral-950">
    <div class="absolute -right-40 -top-40 size-[600px] rounded-full bg-brand-600/10 blur-[120px]"></div>
    <div class="absolute -bottom-24 left-1/4 size-[420px] rounded-full bg-brand-700/10 blur-[100px]"></div>
    <div
      class="absolute inset-0 bg-[linear-gradient(rgba(124,58,237,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(124,58,237,0.03)_1px,transparent_1px)] bg-[size:48px_48px]"
    >
    </div>
  </div>

  <div class="relative h-px w-full bg-gradient-to-r from-transparent via-brand-400/40 to-transparent"></div>

  <div class="relative mx-auto max-w-7xl px-5 pb-10 pt-20 lg:px-8">
    <!-- brand block sits in the grid alongside the link columns, so every
         column shares one top edge and one left edge -->
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="sm:col-span-2 lg:col-span-4">
        <a href="/" class="group inline-flex">
          <img
            src="/images/logo-white.png"
            alt={business.name}
            class="h-11 w-auto transition-transform duration-300 group-hover:scale-105"
            width="730"
            height="730"
          />
        </a>

        <p class="mt-5 max-w-sm text-sm leading-relaxed text-neutral-400">
          {business.tagline} Data-driven performance marketing for businesses across the UAE.
        </p>

        <ul class="mt-6 space-y-2.5">
          <li>
            <a href={business.phoneHref} class={linkClass}>{business.phone}</a>
          </li>
          <li>
            <a href={`mailto:${business.email}`} class={`${linkClass} break-words`}>{business.email}</a>
          </li>
          <li class="text-sm text-neutral-400">{business.address.city}, UAE</li>
        </ul>

        <div class="mt-6 flex items-center gap-3">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.label}
              class="flex size-10 items-center justify-center rounded-full border border-white/10 bg-white/5 text-neutral-400 transition-all duration-300 hover:border-brand-400/40 hover:bg-white/10 hover:text-white"
            >
              <Icon name={link.icon} class="size-5" />
            </a>
          ))}
        </div>
      </div>

      <nav class="lg:col-span-3" aria-label="Services">
        <h3 class={headingClass}>Services</h3>
        <ul class="mt-5 space-y-3">
          {serviceTypes.map((service) => (
            <li>
              <a href={serviceUrl(service.slug)} class={linkClass}>{service.name}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="lg:col-span-3" aria-label="Locations">
        <h3 class={headingClass}>Locations</h3>
        <ul class="mt-5 space-y-3">
          {serviceAreas.map((area) => (
            <li>
              <a href={areaUrl(area.slug)} class={linkClass}>{area.name}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="lg:col-span-2" aria-label="Company">
        <h3 class={headingClass}>Company</h3>
        <ul class="mt-5 space-y-3">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>{link.label}</a>
            </li>
          ))}
        </ul>

        <h3 class={`${headingClass} mt-9`}>GNEXT Group</h3>
        <ul class="mt-5 space-y-3">
          {groupCompanies.map((company) => (
            <li>
              <a href={company.href} target="_blank" rel="noopener" class={`group inline-flex items-center gap-2.5 ${linkClass}`}>
                <span class={`size-1.5 shrink-0 rounded-full ${company.dot}`}></span>
                {company.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- bottom bar -->
    <div class="mt-16 flex flex-col items-start justify-between gap-3 border-t border-white/10 pt-8 sm:flex-row sm:items-center">
      <p class="text-xs text-neutral-500">
        &copy; {new Date().getFullYear()} {business.name}. All rights reserved. A GNEXT Group Company.
      </p>
    </div>
  </div>
</footer>
