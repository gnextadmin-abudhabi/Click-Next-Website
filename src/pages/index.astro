                    { id: 'lp-spend', label: 'Spend', value: channels[0].spend },
                    { id: 'lp-leads', label: 'Leads', value: channels[0].leads },
                    { id: 'lp-cpl', label: 'Cost / lead', value: channels[0].cpl },
