            <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-neutral-900/60 shadow-2xl shadow-black/50 backdrop-blur-2xl">
              <!-- window chrome -->
              <div class="flex items-center justify-between border-b border-white/[0.07] px-5 py-3.5">
