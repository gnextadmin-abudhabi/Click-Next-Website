              </div>

              <div class="p-6">
                <p class="text-xs font-medium uppercase tracking-widest text-neutral-500">Return on ad spend</p>
                <div class="mt-2 flex items-end gap-3">
                  <span id="lp-roas" class="font-display text-6xl font-bold leading-none tracking-tight text-white">6.2x</span>
                  <span
                    id="lp-delta"
                    class="mb-1.5 inline-flex items-center gap-1 rounded-lg bg-emerald-500/12 px-2 py-1 text-xs font-semibold text-emerald-400"
                  >
                    <Icon name="lucide:arrow-up-right" class="size-3.5" />
                    <span>+340%</span>
                  </span>
                </div>

                <!-- bar chart -->
                <div id="lp-chart" class="mt-7 flex h-32 items-end gap-2">
                  {channels[0].bars.map((h, i) => (
                    <div class="flex h-full flex-1 items-end">
                      <div
                        class="lp-bar w-full rounded-t-md bg-gradient-to-t from-brand-700/50 via-brand-500 to-brand-300"
                        style={`--h:${h}%;--lp-delay:${i * 70 + 400}ms`}
