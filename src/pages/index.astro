                  <span class="size-2.5 rounded-full bg-red-400/70"></span>
                  <span class="size-2.5 rounded-full bg-amber-400/70"></span>
                  <span class="size-2.5 rounded-full bg-emerald-400/70"></span>
                </div>
                <span class="flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-widest text-neutral-500">
                  <span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>
                  Live
                </span>
              </div>

              <!-- channel tabs -->
              <div class="flex gap-1 px-4 pt-4">
                {channels.map((c, i) => (
                  <button
                    type="button"
                    class={`lp-ch-tab flex flex-1 items-center justify-center gap-1.5 rounded-xl px-3 py-2 text-xs font-semibold transition-all duration-300 ${i === 0 ? 'bg-white/10 text-white ring-1 ring-white/15' : 'text-neutral-500 hover:bg-white/5 hover:text-neutral-300'}`}
                    data-ch={c.key}
                    data-roas={c.roas}
                    data-spend={c.spend}
                    data-leads={c.leads}
                    data-cpl={c.cpl}
                    data-delta={c.delta}
                    data-bars={c.bars.join(',')}
