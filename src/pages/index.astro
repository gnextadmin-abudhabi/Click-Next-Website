                data-sx={svgX(pin.lng)}
                data-sy={projectY(pin.lat)}
                aria-label={`Show details for ${pin.name}`}
              >
                <span class="relative flex size-6 items-center justify-center">
                  <span class="lp-pin-ring absolute size-4 rounded-full bg-brand-400/40 opacity-0"></span>
                  <span
                    class={`lp-pin relative block rounded-full ring-2 transition-all duration-300 ${i === 0 ? 'is-active size-2.5 bg-white ring-brand-400/70' : 'size-1.5 bg-neutral-400 ring-transparent group-hover:bg-white group-hover:ring-brand-400/50'}`}
                  ></span>
                </span>
                <span
                  class={`lp-pin-label pointer-events-none absolute left-1/2 top-full -translate-x-1/2 whitespace-nowrap rounded-md border border-white/10 bg-neutral-900/90 px-2 py-1 text-[10px] font-medium text-white backdrop-blur-md transition-opacity duration-300 group-hover:opacity-100 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                >
                  {pin.name}
                </span>
              </button>
            ))}
          </div>

          <p class="mt-4 text-center text-[11px] text-neutral-600">
            Pins plotted from real coordinates · {serviceAreas.length} locations served
          </p>
        </div>

        <!-- detail panel -->
        <div class="lp-reveal lp-reveal-xr lg:col-span-5" style="--lp-delay:120ms">
          <div class="flex h-full flex-col rounded-3xl border border-white/[0.08] bg-white/[0.03] p-7 backdrop-blur-sm">
            <div class="flex flex-wrap gap-1.5">
              {areaPins.map((area, i) => (
                <button
                  type="button"
                  class={`lp-area-chip rounded-lg px-2.5 py-1.5 text-[11px] font-medium transition-all duration-300 ${i === 0 ? 'bg-white text-neutral-900' : 'bg-white/5 text-neutral-400 hover:bg-white/10 hover:text-white'}`}
                  data-area={area.slug}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {area.name}
                </button>
              ))}
            </div>

            <div class="mt-7 flex-1">
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-400" id="lp-area-county">
                {areaPins[0].county}
              </p>
              <h3 class="mt-2 font-display text-3xl font-semibold tracking-tight text-white" id="lp-area-name">
                {areaPins[0].name}
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-neutral-400" id="lp-area-desc">
                {areaPins[0].description}
              </p>

              <dl class="mt-7 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-white/[0.07] bg-white/[0.02] p-4">
                  <dt class="text-[10px] uppercase tracking-wider text-neutral-500">Population</dt>
                  <dd class="mt-1 font-display text-lg font-semibold text-white" id="lp-area-pop">1.5M</dd>
                </div>
                <div class="rounded-xl border border-white/[0.07] bg-white/[0.02] p-4">
                  <dt class="text-[10px] uppercase tracking-wider text-neutral-500">Services live</dt>
                  <dd class="mt-1 font-display text-lg font-semibold text-white">{serviceTypes.length}</dd>
                </div>
              </dl>
            </div>

            <a
              href={areaUrl(areaPins[0].slug)}
              id="lp-area-link"
              class="mt-7 inline-flex items-center justify-center gap-2 rounded-xl border border-white/12 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:bg-white/10"
            >
              <span id="lp-area-cta">Explore Abu Dhabi</span>
              <Icon name="lucide:arrow-right" class="size-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       9 — DIFFERENTIATORS · accordion with synced visual
       ============================================================ -->
  <!-- No `overflow-hidden` here either — the synced visual is sticky. -->
  <section id="lp-why" class="relative bg-white py-24 lg:py-32">
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
        <div>
          <div class="lp-reveal">
            <span class="section-label">
              <Icon name="lucide:shield-check" class="size-3.5" />
              Why CLICKNX
            </span>
            <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl">
              Built for results,<br /><span class="text-neutral-400">not retainers.</span>
            </h2>
            <p class="mt-5 max-w-md text-lg leading-relaxed text-neutral-500">
              We do not sell impressions or reach. Every engagement is tracked to the conversion, and every claim we make is
              one you can audit in your own account.
            </p>
          </div>

          <div class="mt-10 divide-y divide-neutral-200 border-y border-neutral-200">
            {differentiators.map((item, i) => (
              <div class={`lp-acc lp-reveal ${i === 0 ? 'is-open' : ''}`} data-acc={i} style={`--lp-delay:${i * 70}ms`}>
                <button
                  type="button"
                  class="lp-acc-trigger flex w-full items-center gap-4 py-5 text-left"
                  aria-expanded={i === 0 ? 'true' : 'false'}
                >
                  <span class={`flex size-10 shrink-0 items-center justify-center rounded-xl transition-colors duration-300 ${i === 0 ? 'bg-brand-600 text-white' : 'bg-neutral-100 text-neutral-500'}`}>
                    <Icon name={item.icon} class="size-4.5" />
                  </span>
                  <span class="flex-1 font-display text-lg font-semibold tracking-tight text-neutral-900">{item.title}</span>
                  <Icon
                    name="lucide:chevron-down"
                    class={`lp-acc-chevron size-5 shrink-0 text-neutral-400 transition-transform duration-300 ${i === 0 ? 'rotate-180' : ''}`}
                  />
                </button>
                <div class="lp-acc-body">
                  <div>
                    <p class="pb-6 pl-14 pr-4 text-sm leading-relaxed text-neutral-500">{item.body}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- synced visual -->
        <div class="lp-reveal lp-reveal-xr lg:sticky lg:top-28 lg:self-start" style="--lp-delay:120ms">
          <div class="relative overflow-hidden rounded-3xl border border-neutral-200 bg-neutral-950">
            <div class="relative aspect-[4/3]">
              {differentiators.map((item, i) => (
                <img
                  src={item.image}
                  alt={item.alt}
                  class={`lp-acc-img absolute inset-0 size-full object-cover transition-all duration-700 ${i === 0 ? 'opacity-90 scale-100' : 'opacity-0 scale-105'}`}
                  data-img={i}
                  width="880"
                  height="660"
                  loading="lazy"
                />
              ))}
              <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/20 to-transparent"></div>
            </div>

            <div class="grid grid-cols-3 divide-x divide-white/[0.07] border-t border-white/[0.07]">
              {[
                { v: `${serviceTypes.length}`, l: 'Specialisms' },
                { v: `${serviceAreas.length}`, l: 'Locations' },
                { v: '48hr', l: 'To launch' },
              ].map((s) => (
                <div class="p-5 text-center">
                  <p class="font-display text-xl font-bold text-white">{s.v}</p>
                  <p class="mt-0.5 text-[10px] uppercase tracking-wider text-neutral-500">{s.l}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       10 — CTA · rotating conic glow + magnetic button
       ============================================================ -->
  <section id="lp-cta" class="relative overflow-hidden bg-neutral-950 py-24 lg:py-32">
    <div class="lp-grid pointer-events-none absolute inset-0 opacity-60"></div>
    <div class="pointer-events-none absolute inset-0">
      <div class="lp-aurora size-[40rem] left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-brand-700/25" style="animation-duration:26s"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-conic lp-reveal lp-reveal-s overflow-hidden rounded-[2rem] p-px" style="--lp-conic-bg:#0a0a0a">
        <div class="relative overflow-hidden rounded-[2rem] bg-neutral-950 px-7 py-16 text-center sm:px-14 lg:py-20">
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-brand-900/25 via-transparent to-transparent"></div>

          <div class="relative">
            <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-300 backdrop-blur-md">
              <span class="lp-live flex size-1.5 rounded-full bg-brand-400 text-brand-400"></span>
              Accepting new accounts
            </span>

            <h2 class="mt-7 font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-6xl">
              Let's find the leak<br />
              <span class="lp-shine">in your funnel</span>
            </h2>

            <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-neutral-400">
              A free audit of your ad accounts, tracking setup and landing pages. You get the findings and the roadmap
              whether or not you work with us.
            </p>

            <div class="mt-10 flex flex-col items-center justify-center gap-3.5 sm:flex-row">
              <a
                href={contactUrl()}
                data-magnetic
                class="lp-magnetic lp-sheen group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-white px-8 py-4 text-sm font-semibold text-neutral-900 shadow-[0_20px_45px_-18px_rgba(255,255,255,0.55)]"
              >
                <span class="lp-sheen-bar"></span>
                Book your free audit
                <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
              </a>
              <a
                href={business.phoneHref}
                class="inline-flex items-center justify-center gap-2.5 rounded-2xl border border-white/12 bg-white/5 px-8 py-4 text-sm font-semibold text-white backdrop-blur-md transition-all duration-300 hover:border-white/25 hover:bg-white/10"
              >
                <Icon name="lucide:phone" class="size-4 text-brand-300" />
                {business.phone}
              </a>
            </div>

            <div class="mt-10 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-xs text-neutral-500">
              {['No lock-in contracts', 'You own every account', 'Reporting you can audit'].map((t) => (
                <span class="inline-flex items-center gap-1.5">
                  <Icon name="lucide:circle-check" class="size-3.5 text-brand-400" />
                  {t}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Uniform grid when a service filter is applied */
  @media (min-width: 1024px) {
    #lp-svc-grid.is-uniform > [data-card] {
      grid-column: span 2 / span 2;
      grid-row: span 1 / span 1;
    }
  }
  #lp-svc-grid > [data-card].is-hidden {
    display: none;
  }
  /* Active map pin ring */
  .lp-map-pin .lp-pin-ring {
    animation: lpPing 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .lp-map-pin.is-active .lp-pin-ring {
    opacity: 1;
  }
  /* Landmass dots brighten around the selected emirate */
  .lp-dot {
    transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #lp-map-glow {
    transition:
      opacity 0.6s ease,
      cx 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      cy 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .lp-dot,
    #lp-map-glow {
      transition: none;
    }
    .lp-map-pin .lp-pin-ring {
      animation: none;
    }
  }
</style>

<script>
  // ============================================================
  // Landing page interactions
  // ============================================================
  // Scroll progress, reveal, count-up, spotlight and magnetic buttons are
  // shared with the other pages.
  import { prefersReducedMotion as reduceMotion } from '../scripts/motion';

  // ---------- Hero ambient glow ----------
  const hero = document.getElementById('lp-hero');
  const heroGlow = document.getElementById('lp-hero-glow');
  if (hero && heroGlow && !reduceMotion) {
    hero.addEventListener('pointermove', (e) => {
      const rect = hero.getBoundingClientRect();
      heroGlow.style.setProperty('--hx', `${e.clientX - rect.left}px`);
      heroGlow.style.setProperty('--hy', `${e.clientY - rect.top}px`);
      heroGlow.style.opacity = '1';
    });
    hero.addEventListener('pointerleave', () => {
      heroGlow.style.opacity = '0';
    });
  }

  // ---------- Hero dashboard channel tabs ----------
  const chTabs = document.querySelectorAll<HTMLButtonElement>('.lp-ch-tab');
  const chart = document.getElementById('lp-chart');
  const roasEl = document.getElementById('lp-roas');
  const deltaEl = document.getElementById('lp-delta')?.querySelector('span');
  const spendEl = document.getElementById('lp-spend');
  const leadsEl = document.getElementById('lp-leads');
  const cplEl = document.getElementById('lp-cpl');

  function selectChannel(tab: HTMLButtonElement) {
    chTabs.forEach((t) => {
      const active = t === tab;
      t.setAttribute('aria-pressed', String(active));
      t.classList.toggle('bg-white/10', active);
      t.classList.toggle('text-white', active);
      t.classList.toggle('ring-1', active);
      t.classList.toggle('ring-white/15', active);
      t.classList.toggle('text-neutral-500', !active);
      t.classList.toggle('hover:bg-white/5', !active);
      t.classList.toggle('hover:text-neutral-300', !active);
    });

    if (roasEl) roasEl.textContent = `${tab.dataset.roas}x`;
    if (deltaEl) deltaEl.textContent = tab.dataset.delta || '';
    if (spendEl) spendEl.textContent = tab.dataset.spend || '';
    if (leadsEl) leadsEl.textContent = tab.dataset.leads || '';
    if (cplEl) cplEl.textContent = tab.dataset.cpl || '';

    const bars = (tab.dataset.bars || '').split(',');
    chart?.querySelectorAll<HTMLElement>('.lp-bar').forEach((bar, i) => {
      bar.style.setProperty('--h', `${bars[i] || 50}%`);
      if (reduceMotion) return;
      bar.style.setProperty('--lp-delay', `${i * 45}ms`);
      bar.style.animation = 'none';
      void bar.offsetWidth; // force reflow to restart the animation
      bar.style.animation = '';
    });
  }

  chTabs.forEach((tab) => tab.addEventListener('click', () => selectChannel(tab)));

  // ---------- Service filter ----------
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.lp-filter');
  const svcGrid = document.getElementById('lp-svc-grid');
  const svcEmpty = document.getElementById('lp-svc-empty');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter || 'all';

      filterBtns.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('border-neutral-900', active);
        b.classList.toggle('bg-neutral-900', active);
        b.classList.toggle('text-white', active);
        b.classList.toggle('border-neutral-200', !active);
        b.classList.toggle('bg-white', !active);
        b.classList.toggle('text-neutral-500', !active);
        b.classList.toggle('hover:border-neutral-400', !active);
        b.classList.toggle('hover:text-neutral-900', !active);
      });

      svcGrid?.classList.toggle('is-uniform', key !== 'all');

      let shown = 0;
      svcGrid?.querySelectorAll<HTMLElement>('[data-card]').forEach((card, i) => {
        const match = key === 'all' || card.dataset.cat === key;
        card.classList.toggle('is-hidden', !match);
        if (match) {
          shown++;
          if (!reduceMotion) {
            card.classList.remove('is-in');
            card.style.setProperty('--lp-delay', `${Math.min(i, 8) * 45}ms`);
            requestAnimationFrame(() => requestAnimationFrame(() => card.classList.add('is-in')));
          }
        }
      });

      svcEmpty?.classList.toggle('hidden', shown > 0);
    });
  });

  // ---------- Process: scroll-driven step indicator ----------
  const steps = document.querySelectorAll<HTMLElement>('.lp-step');
  const stepNav = document.querySelectorAll<HTMLButtonElement>('.lp-step-nav');
  const stepNumEl = document.getElementById('lp-step-num');

  function setActiveStep(index: number) {
    if (stepNumEl) stepNumEl.textContent = String(index + 1).padStart(2, '0');
    stepNav.forEach((nav, i) => {
      const fill = nav.querySelector<HTMLElement>('.lp-step-fill');
      const label = nav.querySelector<HTMLElement>('.lp-step-label');
      if (fill) {
        fill.classList.toggle('h-full', i === index);
        fill.classList.toggle('h-0', i !== index);
      }
      if (label) {
        label.classList.toggle('text-white', i === index);
        label.classList.toggle('text-neutral-600', i !== index);
      }
    });
    steps.forEach((s, i) => {
      s.classList.toggle('border-white/15', i === index);
      s.classList.toggle('bg-white/[0.06]', i === index);
      s.classList.toggle('border-white/[0.08]', i !== index);
      s.classList.toggle('bg-white/[0.03]', i !== index);
    });
  }

  if (steps.length) {
    const stepObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActiveStep(Number((entry.target as HTMLElement).dataset.step || 0));
        });
      },
      { threshold: 0.55, rootMargin: '-20% 0px -25% 0px' }
    );
    steps.forEach((s) => stepObserver.observe(s));

    stepNav.forEach((nav) => {
      nav.addEventListener('click', () => {
        const target = steps[Number(nav.dataset.goto || 0)];
        target?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
      });
    });
  }

  // ---------- ROI calculator ----------
  const CPC = 6;
  const CLOSE_RATE = 0.2;
  const CVR_UPLIFT = 1.8;
  const CPC_DISCOUNT = 0.75;

  const inSpend = document.getElementById('lp-in-spend') as HTMLInputElement | null;
  const inCvr = document.getElementById('lp-in-cvr') as HTMLInputElement | null;
  const inDeal = document.getElementById('lp-in-deal') as HTMLInputElement | null;

  const aed = (n: number) => `AED ${Math.round(n).toLocaleString('en-US')}`;
  const compact = (n: number) =>
    n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}K` : String(Math.round(n));

  function paintRange(el: HTMLInputElement | null) {
    if (!el) return;
    const min = Number(el.min);
    const max = Number(el.max);
    const pct = ((Number(el.value) - min) / (max - min)) * 100;
    el.style.setProperty('--fill', `${pct}%`);
  }

  function setText(id: string, value: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  function recalc() {
    if (!inSpend || !inCvr || !inDeal) return;

    const spend = Number(inSpend.value);
    const cvr = Number(inCvr.value) / 100;
    const deal = Number(inDeal.value);

    [inSpend, inCvr, inDeal].forEach(paintRange);

    setText('lp-out-spend', aed(spend));
    setText('lp-out-cvr', `${Number(inCvr.value).toFixed(1)}%`);
    setText('lp-out-deal', aed(deal));

    // current scenario
    const clicks = spend / CPC;
    const leads = clicks * cvr;
    const revenue = leads * CLOSE_RATE * deal;
    const roas = revenue / spend;

    // optimised scenario
    const clicksNew = spend / (CPC * CPC_DISCOUNT);
    const leadsNew = clicksNew * Math.min(cvr * CVR_UPLIFT, 0.35);
    const revenueNew = leadsNew * CLOSE_RATE * deal;
    const roasNew = revenueNew / spend;

    setText('lp-res-roas-now', `${roas.toFixed(1)}x`);
    setText('lp-res-roas-new', `${roasNew.toFixed(1)}x`);
    setText('lp-res-rev-now', aed(revenue));
    setText('lp-res-rev-new', aed(revenueNew));
    setText('lp-res-clicks', compact(clicks));
    setText('lp-res-leads', compact(leads));
    setText('lp-res-cpl', aed(leads > 0 ? spend / leads : 0));
    setText('lp-res-uplift', aed(Math.max(revenueNew - revenue, 0) * 12));

    const peak = Math.max(revenue, revenueNew, 1);
    const barNow = document.getElementById('lp-bar-now');
    const barNew = document.getElementById('lp-bar-new');
    if (barNow) barNow.style.width = `${Math.max((revenue / peak) * 100, 3)}%`;
    if (barNew) barNew.style.width = `${Math.max((revenueNew / peak) * 100, 3)}%`;
  }

  [inSpend, inCvr, inDeal].forEach((el) => el?.addEventListener('input', recalc));
  recalc();

  // ---------- Coverage map explorer ----------
  // Area data is injected by the inline `define:vars` script at the top of the page.
  interface AreaInfo {
    name: string;
    county: string;
    description: string;
    population: number;
    url: string;
  }
  declare global {
    interface Window {
      __CLICKNX_AREAS__?: Record<string, AreaInfo>;
    }
  }

  const areaChips = document.querySelectorAll<HTMLButtonElement>('.lp-area-chip');
  const areaPinsEls = document.querySelectorAll<HTMLButtonElement>('.lp-map-pin');
  const mapDotEls = document.querySelectorAll<SVGCircleElement>('.lp-dot');

  function selectArea(slug: string) {
    areaChips.forEach((chip) => {
      const active = chip.dataset.area === slug;
      chip.setAttribute('aria-pressed', String(active));
      chip.classList.toggle('bg-white', active);
      chip.classList.toggle('text-neutral-900', active);
      chip.classList.toggle('bg-white/5', !active);
      chip.classList.toggle('text-neutral-400', !active);
      chip.classList.toggle('hover:bg-white/10', !active);
      chip.classList.toggle('hover:text-white', !active);
    });

    let focusX = 0;
    let focusY = 0;

    areaPinsEls.forEach((pinBtn) => {
      const active = pinBtn.dataset.area === slug;
      pinBtn.classList.toggle('is-active', active);

      const dot = pinBtn.querySelector<HTMLElement>('.lp-pin');
      dot?.classList.toggle('is-active', active);
      dot?.classList.toggle('size-2.5', active);
      dot?.classList.toggle('bg-white', active);
      dot?.classList.toggle('ring-brand-400/70', active);
      dot?.classList.toggle('size-1.5', !active);
      dot?.classList.toggle('bg-neutral-400', !active);
      dot?.classList.toggle('ring-transparent', !active);

      pinBtn.querySelector('.lp-pin-label')?.classList.toggle('opacity-100', active);
      pinBtn.querySelector('.lp-pin-label')?.classList.toggle('opacity-0', !active);

      if (active) {
        focusX = Number(pinBtn.dataset.sx || 0);
        focusY = Number(pinBtn.dataset.sy || 0);
      }
    });

    // Light the landmass around the selected emirate.
    const glow = document.getElementById('lp-map-glow');
    if (glow) {
      glow.setAttribute('cx', String(focusX));
      glow.setAttribute('cy', String(focusY));
      glow.setAttribute('opacity', '1');
    }
    mapDotEls.forEach((d) => {
      const dx = Number(d.getAttribute('cx')) - focusX;
      const dy = Number(d.getAttribute('cy')) - focusY;
      const falloff = Math.max(0, 1 - Math.hypot(dx, dy) / 32);
      d.setAttribute('opacity', String((0.2 + 0.75 * falloff * falloff).toFixed(3)));
    });

    const info = window.__CLICKNX_AREAS__?.[slug];
    if (!info) return;

    setText('lp-area-name', info.name);
    setText('lp-area-county', info.county);
    setText('lp-area-desc', info.description);
    setText('lp-area-pop', info.population >= 1000000
      ? `${(info.population / 1000000).toFixed(1)}M`
      : `${Math.round(info.population / 1000)}K`);
    setText('lp-area-cta', `Explore ${info.name}`);
    const link = document.getElementById('lp-area-link') as HTMLAnchorElement | null;
    if (link) link.href = info.url;
  }

  areaChips.forEach((chip) => chip.addEventListener('click', () => selectArea(chip.dataset.area || '')));
  areaPinsEls.forEach((pinBtn) => pinBtn.addEventListener('click', () => selectArea(pinBtn.dataset.area || '')));

  // Seed the dot falloff for whichever emirate is marked active in the markup.
  const initialArea = document.querySelector<HTMLButtonElement>('.lp-map-pin.is-active')?.dataset.area;
  if (initialArea) selectArea(initialArea);

  // ---------- Differentiator accordion ----------
  const accItems = document.querySelectorAll<HTMLElement>('.lp-acc');
  const accImages = document.querySelectorAll<HTMLElement>('.lp-acc-img');

  accItems.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('.lp-acc-trigger');
    trigger?.addEventListener('click', () => {
      const index = Number(item.dataset.acc || 0);
      const alreadyOpen = item.classList.contains('is-open');

      accItems.forEach((other) => {
        const open = other === item && !alreadyOpen;
        other.classList.toggle('is-open', open);
        other.querySelector('.lp-acc-trigger')?.setAttribute('aria-expanded', String(open));
        other.querySelector('.lp-acc-chevron')?.classList.toggle('rotate-180', open);
        const badge = other.querySelector<HTMLElement>('.lp-acc-trigger > span:first-child');
        badge?.classList.toggle('bg-brand-600', open);
        badge?.classList.toggle('text-white', open);
        badge?.classList.toggle('bg-neutral-100', !open);
        badge?.classList.toggle('text-neutral-500', !open);
      });

      if (!alreadyOpen) {
        accImages.forEach((img, i) => {
          const active = i === index;
          img.classList.toggle('opacity-90', active);
          img.classList.toggle('scale-100', active);
          img.classList.toggle('opacity-0', !active);
          img.classList.toggle('scale-105', !active);
        });
      }
    });
  });
</script>
