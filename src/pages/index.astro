// ---------- Coverage map: derive pin positions from real coordinates ----------
// Equirectangular projection into a 0-100 box. The SVG outline below uses the
// same function with preserveAspectRatio="none", so pins and coastline align.
const BOUNDS = { minLng: 51.3, maxLng: 56.6, minLat: 22.4, maxLat: 26.3 };
const projectX = (lng: number) => Math.round(((lng - BOUNDS.minLng) / (BOUNDS.maxLng - BOUNDS.minLng)) * 1000) / 10;
const projectY = (lat: number) => Math.round(((BOUNDS.maxLat - lat) / (BOUNDS.maxLat - BOUNDS.minLat)) * 1000) / 10;

const areaPins = serviceAreas.map((area) => ({
  ...area,
  x: projectX(area.lng),
  y: projectY(area.lat),
}));

// Simplified UAE border, traced along the Gulf coast then back along the inland
// frontier with Saudi Arabia and Oman.
const uaeBorder: [number, number][] = [
  [51.58, 24.26], [51.62, 24.06], [52.05, 23.96], [52.62, 24.16], [53.42, 24.16],
  [54.02, 24.06], [54.5, 24.3], [55.02, 24.62], [55.5, 25.1], [55.86, 25.5],
  [56.06, 25.72], [56.38, 25.96], [56.4, 25.58], [56.34, 25.2], [56.2, 24.95],
  [55.82, 24.26], [55.56, 23.96], [55.22, 23.0], [53.0, 22.62], [51.6, 22.96],
];

// The map is drawn as a dot matrix rather than a filled outline: the abstraction
// reads as deliberate data-viz and is forgiving of an approximate border.
// SVG space is 160x100 so that, inside a 16/10 box with preserveAspectRatio
// "none", the x and y scales match and the dots stay perfectly round.
const svgX = (lng: number) => Math.round(projectX(lng) * 16) / 10;

function insideUae(lng: number, lat: number): boolean {
  let inside = false;
  for (let i = 0, j = uaeBorder.length - 1; i < uaeBorder.length; j = i++) {
    const [xi, yi] = uaeBorder[i];
    const [xj, yj] = uaeBorder[j];
    if (yi > lat !== yj > lat && lng < ((xj - xi) * (lat - yi)) / (yj - yi) + xi) inside = !inside;
  }
  return inside;
}

const DOT_COLS = 62;
const DOT_ROWS = 39; // 62 / 1.6, keeps the grid visually square
const mapDots: { x: number; y: number }[] = [];
for (let row = 0; row < DOT_ROWS; row++) {
  for (let col = 0; col < DOT_COLS; col++) {
    const bx = ((col + 0.5) / DOT_COLS) * 100;
    const by = ((row + 0.5) / DOT_ROWS) * 100;
    const lng = BOUNDS.minLng + (bx / 100) * (BOUNDS.maxLng - BOUNDS.minLng);
    const lat = BOUNDS.maxLat - (by / 100) * (BOUNDS.maxLat - BOUNDS.minLat);
    if (insideUae(lng, lat)) {
      mapDots.push({ x: Math.round(bx * 16) / 10, y: Math.round(by * 10) / 10 });
    }
  }
}

const schema = {
