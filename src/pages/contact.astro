---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${business.name}`,
  description: `Get in touch with ${business.name} for a free performance marketing consultation.`,
  url: `${business.siteUrl}/contact/`,
};
---

<BaseLayout
  title={`Contact ${business.name} | Free Marketing Consultation Abu Dhabi`}
  description={`Get in touch with ${business.name} for a free performance marketing consultation. Email ${business.email} or fill out our contact form. Serving businesses across the UAE.`}
  schema={schema}
>
  <Breadcrumbs crumbs={[{ label: 'Contact' }]} />

  <!-- ============ HEADER ============ -->
  <section class="relative overflow-hidden bg-neutral-950 py-20 lg:py-28">
    <!-- Background image -->
    <div class="absolute inset-0">
      <img
        src="/images/performance/paid-media-audit.webp"
        alt="Illustrated paid media audit identifying wasted spend, conversion friction, tracking gaps, and growth opportunities"
        class="h-full w-full object-cover opacity-45"
        width="1024"
        height="576"
        loading="eager"
      />
    </div>
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-neutral-950/95 via-neutral-950/80 to-neutral-950/60" />

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">
        <div>
          <span class="section-label bg-brand-500/10 border-brand-500/20 text-brand-300">
            <Icon name="lucide:mail" class="size-3.5" />
            Get in Touch
          </span>
          <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight text-white sm:text-6xl">
            Let Us Talk About<br />Your Growth
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-neutral-300">
            Ready to scale your business with data-driven marketing? Reach out for a free strategy consultation. We typically respond within one business day.
          </p>
        </div>
        <div class="hidden lg:block">
          <img
            src="/images/performance/paid-media-audit.webp"
            alt="Paid media diagnostic illustration connecting campaign issues with a prioritized performance improvement plan"
            class="rounded-2xl border border-white/10 shadow-2xl shadow-brand-950/50"
            width="1024"
            height="576"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FORM + CONTACT INFO ============ -->
  <section class="pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
        <!-- Left: Contact Form -->
        <div class="lg:col-span-3">
          <div class="rounded-2xl border border-neutral-200 bg-white p-8 sm:p-10">
            <h2 class="font-display text-2xl font-semibold text-neutral-900">Send Us a Message</h2>
            <p class="mt-2 text-sm text-neutral-500">
              Fill out the form and our team will get back to you as soon as possible.
            </p>

            <form action="#" method="POST" class="mt-8 space-y-6">
              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="name" class="block text-sm font-medium text-neutral-700">
                    Full Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text" id="name" name="name" required
                    placeholder="Your name"
                    class="mt-1.5 w-full rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-neutral-700">
                    Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email" id="email" name="email" required
                    placeholder="you@company.com"
                    class="mt-1.5 w-full rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  />
                </div>
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="phone" class="block text-sm font-medium text-neutral-700">
                    Phone Number
                  </label>
                  <input
                    type="tel" id="phone" name="phone"
                    placeholder="+971 50 XXX XXXX"
                    class="mt-1.5 w-full rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  />
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-neutral-700">
                    Company Name
                  </label>
                  <input
                    type="text" id="company" name="company"
                    placeholder="Your company"
                    class="mt-1.5 w-full rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  />
                </div>
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="service" class="block text-sm font-medium text-neutral-700">
                    Service Interested In
                  </label>
                  <select
                    id="service" name="service"
                    class="mt-1.5 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  >
                    <option value="">Select a service</option>
                    {serviceTypes.map((service) => (
                      <option value={service.slug}>{service.name}</option>
                    ))}
                    <option value="multiple">Multiple Services</option>
                    <option value="not-sure">Not Sure Yet</option>
                  </select>
                </div>
                <div>
                  <label for="budget" class="block text-sm font-medium text-neutral-700">
                    Monthly Budget (AED)
                  </label>
                  <select
                    id="budget" name="budget"
                    class="mt-1.5 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  >
                    <option value="">Select budget range</option>
                    <option value="5k-10k">AED 5,000 - 10,000</option>
                    <option value="10k-25k">AED 10,000 - 25,000</option>
                    <option value="25k-50k">AED 25,000 - 50,000</option>
                    <option value="50k+">AED 50,000+</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-neutral-700">
                  Tell Us About Your Goals <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message" name="message" required rows="5"
                  placeholder="What are your marketing goals? What challenges are you facing?"
                  class="mt-1.5 w-full rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="gradient-cta group inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5"
              >
                Send Message
                <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
              </button>
            </form>
          </div>
        </div>

        <!-- Right: Contact Info Card -->
        <div class="lg:col-span-2">
          <div class="rounded-2xl border border-neutral-200 bg-white p-8 sm:p-10">
            <h2 class="font-display text-xl font-semibold text-neutral-900">Contact Information</h2>

            <ul class="mt-6 space-y-5">
              <li class="flex items-start gap-4">
                <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50">
                  <Icon name="lucide:phone" class="size-5 text-brand-600" />
                </div>
                <div>
                  <p class="text-sm font-medium text-neutral-700">Phone</p>
                  <a href={`tel:${business.phoneTel}`} class="text-sm text-brand-600 hover:text-brand-700 transition-colors block">{business.phone}</a>
                  <a href={`tel:+971506115911`} class="text-sm text-neutral-400 hover:text-brand-600 transition-colors block mt-0.5">+971 50 611 5911</a>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-[#25D366]/10">
                  <svg class="size-5 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-medium text-neutral-700">WhatsApp</p>
                  <a href="https://wa.me/971556115985?text=Hi%20CLICKNX%2C%20I%20would%20like%20to%20discuss%20a%20marketing%20project." target="_blank" rel="noopener" class="text-sm text-[#25D366] hover:text-[#128C7E] transition-colors">+971 55 611 5985</a>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50">
                  <Icon name="lucide:mail" class="size-5 text-brand-600" />
                </div>
                <div>
                  <p class="text-sm font-medium text-neutral-700">Email</p>
                  <a href={`mailto:${business.email}`} class="text-sm text-brand-600 hover:text-brand-700 transition-colors">{business.email}</a>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50">
                  <Icon name="lucide:map-pin" class="size-5 text-brand-600" />
                </div>
                <div>
                  <p class="text-sm font-medium text-neutral-700">Office</p>
                  <p class="text-sm text-neutral-500">{business.address.street}<br />{business.address.city}, {business.address.country}<br />PO Box {business.address.zip}</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand-50">
                  <Icon name="lucide:clock" class="size-5 text-brand-600" />
                </div>
                <div>
                  <p class="text-sm font-medium text-neutral-700">Business Hours</p>
                  <div class="mt-1 space-y-0.5 text-sm text-neutral-500">
                    {business.hours.map((schedule) => (
                      <p><span class="font-medium text-neutral-700">{schedule.days}:</span> {schedule.hours}</p>
                    ))}
                  </div>
                </div>
              </li>
            </ul>

            <div class="mt-8 rounded-xl border border-brand-200 bg-brand-50 p-5">
              <div class="flex items-start gap-3">
                <Icon name="lucide:lightbulb" class="mt-0.5 size-5 shrink-0 text-brand-600" />
                <div>
                  <p class="text-sm font-semibold text-brand-800">Free Strategy Consultation</p>
                  <p class="mt-1 text-sm text-brand-700">
                    Not sure where to start? Book a free 30-minute strategy call and we will analyze your current marketing to identify the biggest growth opportunities.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
