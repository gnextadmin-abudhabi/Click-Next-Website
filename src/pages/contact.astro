---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';

const heroChips = [
  { icon: 'lucide:clock', label: 'Reply within 1 business day' },
  { icon: 'lucide:gift', label: 'Free audit, no obligation' },
  { icon: 'lucide:shield-check', label: 'No lock-in contract' },
];

const nextSteps = [
  {
    icon: 'lucide:inbox',
    title: 'We read it properly',
    body: 'Your message goes straight to a strategist, not a shared inbox. We reply within one business day with either questions or a proposed time to talk.',
  },
  {
    icon: 'lucide:search',
    title: 'We audit before we pitch',
    body: 'With read-only access to your ad accounts and analytics we run a full diagnostic — wasted spend, tracking gaps and conversion friction.',
  },
  {
    icon: 'lucide:file-text',
    title: 'You keep the findings',
    body: 'You get the audit and a prioritised roadmap in writing, whether or not you decide to work with us. No pressure, no retainer required to see it.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${business.name}`,
  description: `Get in touch with ${business.name} for a free performance marketing consultation.`,
  url: `${business.siteUrl}/contact/`,
};
---

<BaseLayout
  title={`Contact ${business.name} | Free Marketing Consultation Abu Dhabi`}
  description={`Get in touch with ${business.name} for a free performance marketing consultation. Email ${business.email} or fill out our contact form. Serving businesses across the UAE.`}
  schema={schema}
>
  <!-- ============================================================
       1 — HERO · copy left, illustration shown properly on the right
       ============================================================ -->
  <section class="relative overflow-hidden bg-neutral-950 py-20 lg:py-28">
    <div class="lp-grid pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="lp-aurora size-[34rem] -left-32 -top-32 bg-brand-700/30" style="animation-duration:28s"></div>
      <div class="lp-aurora size-[26rem] right-0 bottom-[-6rem] bg-cyan-600/15" style="animation-duration:24s;animation-delay:-8s"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <span class="lp-reveal inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-300 backdrop-blur-md">
            <Icon name="lucide:mail" class="size-3.5" />
            Get in touch
          </span>

          <h1 class="lp-reveal mt-6 font-display text-[2.6rem] font-semibold leading-[1.05] tracking-tight text-white sm:text-6xl" style="--lp-delay:60ms">
            Let's talk about<br /><span class="text-brand-400">your growth</span>
          </h1>

          <p class="lp-reveal mt-6 max-w-lg text-lg leading-relaxed text-neutral-400" style="--lp-delay:140ms">
            Ready to scale with data-driven marketing? Send us a note and we will come back with a free strategy
            consultation — usually within one business day.
          </p>

          <div class="lp-reveal mt-8 flex flex-wrap gap-2.5" style="--lp-delay:220ms">
            {heroChips.map((chip) => (
              <span class="inline-flex items-center gap-2 rounded-full border border-white/[0.08] bg-white/[0.03] px-3.5 py-2 text-xs text-neutral-300">
                <Icon name={chip.icon} class="size-3.5 text-brand-400" />
                {chip.label}
              </span>
            ))}
          </div>
        </div>

        <!-- illustration, now at full opacity instead of buried behind the text -->
        <div class="lp-reveal lp-reveal-xr" style="--lp-delay:180ms">
          <div class="overflow-hidden rounded-3xl border border-white/10 bg-neutral-900 shadow-2xl shadow-black/50">
            <img
              src="/images/performance/paid-media-audit.webp"
              alt="Illustrated paid media audit identifying wasted spend, conversion friction, tracking gaps, and growth opportunities"
              class="w-full"
              width="1024"
              height="576"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2 — FORM + CONTACT DETAILS
       ============================================================ -->
  <!-- No `overflow-hidden`: the details card is sticky on desktop. -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-5 lg:gap-12">
        <!-- form -->
        <div class="lg:col-span-3">
          <div class="lp-reveal rounded-3xl border border-neutral-200 bg-white p-8 shadow-[0_24px_60px_-45px_rgba(76,29,149,0.5)] sm:p-10">
            <h2 class="font-display text-2xl font-semibold tracking-tight text-neutral-900">Send us a message</h2>
            <p class="mt-2 text-sm text-neutral-500">
              The more you tell us about your goals, the more useful our first reply will be.
            </p>

            <form action="#" method="POST" class="mt-9 space-y-6">
              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="name" class="block text-sm font-medium text-neutral-700">
                    Full name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text" id="name" name="name" required
                    placeholder="Your name"
                    class="mt-2 w-full rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-neutral-700">
                    Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email" id="email" name="email" required
                    placeholder="you@company.com"
                    class="mt-2 w-full rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
                  />
                </div>
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="phone" class="block text-sm font-medium text-neutral-700">Phone number</label>
                  <input
                    type="tel" id="phone" name="phone"
                    placeholder="+971 50 XXX XXXX"
                    class="mt-2 w-full rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
                  />
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-neutral-700">Company name</label>
                  <input
                    type="text" id="company" name="company"
                    placeholder="Your company"
                    class="mt-2 w-full rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
                  />
                </div>
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="service" class="block text-sm font-medium text-neutral-700">Service interested in</label>
                  <select
                    id="service" name="service"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
                  >
                    <option value="">Select a service</option>
                    {serviceTypes.map((service) => (
                      <option value={service.slug}>{service.name}</option>
                    ))}
                    <option value="multiple">Multiple services</option>
                    <option value="not-sure">Not sure yet</option>
                  </select>
                </div>
                <div>
                  <label for="budget" class="block text-sm font-medium text-neutral-700">Monthly budget (AED)</label>
                  <select
                    id="budget" name="budget"
                    class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
                  >
                    <option value="">Select budget range</option>
                    <option value="5k-10k">AED 5,000 - 10,000</option>
                    <option value="10k-25k">AED 10,000 - 25,000</option>
                    <option value="25k-50k">AED 25,000 - 50,000</option>
                    <option value="50k+">AED 50,000+</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="location" class="block text-sm font-medium text-neutral-700">Where are you based?</label>
                <select
                  id="location" name="location"
                  class="mt-2 w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
                >
                  <option value="">Select a location</option>
                  {serviceAreas.map((area) => (
                    <option value={area.slug}>{area.name}</option>
                  ))}
                  <option value="elsewhere">Elsewhere in the UAE</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-neutral-700">
                  Tell us about your goals <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message" name="message" required rows="5"
                  placeholder="What are your marketing goals? What challenges are you facing?"
                  class="mt-2 w-full rounded-xl border border-neutral-300 px-4 py-3 text-sm text-neutral-900 placeholder-neutral-400 transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20"
                ></textarea>
              </div>

              <div class="flex flex-wrap items-center gap-x-5 gap-y-3 pt-1">
                <button
                  type="submit"
                  class="gradient-cta group inline-flex items-center justify-center gap-2 rounded-xl px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5"
                >
                  Send message
                  <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
                </button>
                <p class="text-xs text-neutral-400">
                  Prefer to talk? Call
                  <a href={business.phoneHref} class="font-medium text-brand-600 hover:text-brand-700">{business.phone}</a>
                </p>
              </div>
            </form>
          </div>
        </div>

        <!-- contact details -->
        <div class="lg:col-span-2">
          <div class="lp-reveal lp-reveal-xr lg:sticky lg:top-28" style="--lp-delay:120ms">
            <div class="rounded-3xl border border-neutral-200 bg-neutral-50 p-8 sm:p-10">
              <h2 class="font-display text-xl font-semibold tracking-tight text-neutral-900">Contact information</h2>

              <ul class="mt-7 space-y-6">
                <li class="flex items-start gap-4">
                  <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white text-brand-600 ring-1 ring-neutral-200">
                    <Icon name="lucide:phone" class="size-5" />
                  </span>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-neutral-700">Phone</p>
                    <a href={business.phoneHref} class="mt-0.5 block text-sm text-brand-600 transition-colors hover:text-brand-700">{business.phone}</a>
                    <a href="tel:+971506115911" class="mt-0.5 block text-sm text-neutral-400 transition-colors hover:text-brand-600">{business.phoneSecondary}</a>
                  </div>
                </li>

                <li class="flex items-start gap-4">
                  <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white ring-1 ring-neutral-200">
                    <svg class="size-5 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                  </span>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-neutral-700">WhatsApp</p>
                    <a
                      href="https://wa.me/971566119525?text=Hi%20CLICKNX%2C%20I%20would%20like%20to%20discuss%20a%20marketing%20project."
                      target="_blank"
                      rel="noopener"
                      class="mt-0.5 block text-sm text-[#25D366] transition-colors hover:text-[#128C7E]"
                    >
                      {business.phone}
                    </a>
                  </div>
                </li>

                <li class="flex items-start gap-4">
                  <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white text-brand-600 ring-1 ring-neutral-200">
                    <Icon name="lucide:mail" class="size-5" />
                  </span>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-neutral-700">Email</p>
                    <a href={`mailto:${business.email}`} class="mt-0.5 block break-words text-sm text-brand-600 transition-colors hover:text-brand-700">
                      {business.email}
                    </a>
                  </div>
                </li>

                <li class="flex items-start gap-4">
                  <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white text-brand-600 ring-1 ring-neutral-200">
                    <Icon name="lucide:map-pin" class="size-5" />
                  </span>
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-neutral-700">Office</p>
                    <p class="mt-0.5 text-sm leading-relaxed text-neutral-500">
                      {business.address.street}<br />
                      {business.address.city}, {business.address.country}<br />
                      PO Box {business.address.zip}
                    </p>
                  </div>
                </li>

                <li class="flex items-start gap-4">
                  <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-white text-brand-600 ring-1 ring-neutral-200">
                    <Icon name="lucide:clock" class="size-5" />
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium text-neutral-700">Business hours</p>
                    <dl class="mt-1.5 space-y-1">
                      {business.hours.map((schedule) => (
                        <div class="flex items-baseline justify-between gap-4 text-sm">
                          <dt class="text-neutral-500">{schedule.days}</dt>
                          <dd class={schedule.hours === 'Closed' ? 'text-neutral-400' : 'font-medium text-neutral-700'}>
                            {schedule.hours}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </div>
                </li>
              </ul>

              <div class="mt-8 rounded-2xl border border-brand-200 bg-brand-50 p-5">
                <div class="flex items-start gap-3">
                  <Icon name="lucide:lightbulb" class="mt-0.5 size-5 shrink-0 text-brand-600" />
                  <div>
                    <p class="text-sm font-semibold text-brand-800">Free strategy consultation</p>
                    <p class="mt-1.5 text-sm leading-relaxed text-brand-700">
                      Not sure where to start? Book a free 30-minute call and we will analyse your current marketing to
                      find the biggest growth opportunities.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       3 — WHAT HAPPENS NEXT · steps beside a supporting visual
       ============================================================ -->
  <section class="border-t border-neutral-200 bg-neutral-50 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
        <div class="lp-reveal order-2 overflow-hidden rounded-3xl border border-neutral-200 bg-neutral-950 lg:order-1">
          <img
            src="/images/performance/uae-performance.webp"
            alt="Illustrated UAE performance marketing coverage connecting campaigns across the emirates"
            class="aspect-[4/3] w-full object-cover"
            width="1200"
            height="900"
            loading="lazy"
          />
        </div>

        <div class="order-1 lg:order-2">
          <div class="lp-reveal">
            <span class="section-label">
              <Icon name="lucide:route" class="size-3.5" />
              What happens next
            </span>
            <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-[2.75rem]">
              After you hit send
            </h2>
          </div>

          <ol class="mt-10 space-y-8">
            {nextSteps.map((step, i) => (
              <li class="lp-reveal flex gap-5" style={`--lp-delay:${i * 80}ms`}>
                <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-white text-brand-600 ring-1 ring-neutral-200">
                  <Icon name={step.icon} class="size-5" />
                </span>
                <div>
                  <h3 class="font-display text-lg font-semibold tracking-tight text-neutral-900">
                    <span class="mr-2 text-sm font-bold tabular-nums text-neutral-300">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    {step.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed text-neutral-500">{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/motion';
</script>
