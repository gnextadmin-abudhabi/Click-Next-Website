---
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../../data/business';
import { serviceTypes } from '../../data/serviceTypes';
import { serviceAreas, getAreaBySlug, getNearbyAreas } from '../../data/serviceAreas';
import { serviceUrl, areaUrl, comboUrl, contactUrl } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SeoTestimonials from '../../components/SeoTestimonials.astro';

import type { ServiceArea } from '../../data/serviceAreas';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { area: area.slug },
    props: { area },
  }));
}

interface Props {
  area: ServiceArea;
}

const { area } = Astro.props;
const nearbyAreas = getNearbyAreas(area);
const years = yearsInBusiness();

const pageTitle = `Performance Marketing in ${area.name} | ${business.name}`;
const metaDescription = `Data-driven performance marketing services in ${area.name}, ${area.county}. ${business.name} helps local businesses grow with Google Ads, Meta Ads, CRO, and more.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${business.name} - ${area.name}`,
  description: `${business.name} provides performance marketing services in ${area.name}, ${area.county}, UAE.`,
  url: `${business.siteUrl}/areas/${area.slug}/`,
  email: business.email,
  address: { '@type': 'PostalAddress', addressLocality: area.name, addressCountry: 'AE' },
  geo: { '@type': 'GeoCoordinates', latitude: area.lat, longitude: area.lng },
  areaServed: [
    { '@type': 'City', name: area.name },
    { '@type': 'AdministrativeArea', name: area.county },
  ],
};
---

<BaseLayout title={pageTitle} description={metaDescription} schema={schema}>
  <Breadcrumbs
    crumbs={[
      { label: 'Areas We Serve', href: '/areas/' },
      { label: area.name },
    ]}
  />

  <!-- ============ DARK HERO WITH GRADIENT ============ -->
  <section class="relative overflow-hidden bg-neutral-950 py-24 lg:py-32">
    <!-- Decorative gradient blobs -->
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-40 -right-40 size-[500px] rounded-full bg-brand-600/15 blur-[120px]" />
      <div class="absolute -bottom-20 left-1/4 size-[400px] rounded-full bg-brand-700/10 blur-[100px]" />
      <div class="absolute inset-0 bg-[linear-gradient(rgba(124,58,237,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(124,58,237,0.03)_1px,transparent_1px)] bg-[size:48px_48px]" />
    </div>

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16 items-center">
        <!-- Left: Content -->
        <div>
          <span class="inline-flex items-center gap-2 rounded-full border border-brand-500/20 bg-brand-500/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-brand-300">
            <Icon name="lucide:map-pin" class="size-3.5" />
            {area.name}, {area.county}
          </span>
          <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight text-white sm:text-6xl lg:text-7xl">
            Performance Marketing in {area.name}
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-neutral-300 max-w-xl">
            {area.description}
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href={contactUrl()}
              class="group inline-flex items-center gap-2.5 rounded-xl bg-white px-6 py-3 text-sm font-semibold text-neutral-900 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
            >
              Get a Free Strategy Call
              <Icon name="lucide:arrow-right" class="size-4 transition-transform group-hover:translate-x-1" />
            </a>
            <a
              href="#services"
              class="inline-flex items-center gap-2.5 rounded-xl border border-white/20 bg-white/5 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition-all duration-300 hover:bg-white/10"
            >
              View Services
            </a>
          </div>
        </div>

        <!-- Right: Stats cards -->
        <div class="grid grid-cols-2 gap-4">
          {[
            { icon: 'lucide:users', value: area.population.toLocaleString(), label: 'Population', color: 'from-brand-500 to-brand-700' },
            { icon: 'lucide:building-2', value: '9', label: 'Services Available', color: 'from-emerald-500 to-emerald-700' },
            { icon: 'lucide:trending-up', value: `${serviceTypes.length * 1}+`, label: 'Campaign Pages', color: 'from-amber-500 to-amber-700' },
            { icon: 'lucide:award', value: `${years}+`, label: 'Years Serving UAE', color: 'from-blue-500 to-blue-700' },
          ].map((stat, i) => (
            <div class={`rounded-2xl bg-gradient-to-br ${stat.color} p-5 text-white animate-fade-up stagger-${i + 1}`}>
              <div class="flex size-10 items-center justify-center rounded-lg bg-white/20 mb-3">
                <Icon name={stat.icon} class="size-5" />
              </div>
              <div class="font-display text-2xl font-bold">{stat.value}</div>
              <div class="mt-0.5 text-sm text-white/80">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom fade to white -->
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-white to-transparent" />
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="services" class="relative overflow-hidden py-24 lg:py-32">
    <!-- Decorative gradient blobs -->
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute top-20 -left-40 size-80 rounded-full bg-brand-100/30 blur-[80px]" />
      <div class="absolute bottom-10 right-1/4 size-64 rounded-full bg-brand-200/20 blur-[60px]" />
    </div>

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <span class="section-label">
          <Icon name="lucide:target" class="size-3.5" />
          Our Services
        </span>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl">
          Services Available in {area.name}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-500">
          Every CLICKNX service is available to businesses in {area.name}. Select a service for localized campaign strategies and pricing.
        </p>
      </div>

      <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {serviceTypes.map((service, i) => (
          <a
            href={comboUrl(area.slug, service.slug)}
            class={`card-hover group relative rounded-2xl border border-neutral-200 bg-white p-8 transition-all duration-300 animate-fade-up stagger-${Math.min(i + 1, 6)}`}
          >
            <!-- Gradient top border on hover -->
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-400 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
            <div class="flex size-11 items-center justify-center rounded-xl bg-gradient-to-br from-brand-50 to-brand-100/60 text-brand-600 mb-5 transition-all duration-300 group-hover:scale-110 group-hover:shadow-md">
              <Icon name={`lucide:${service.icon}`} class="size-5" />
            </div>
            <h3 class="font-display text-lg font-semibold text-neutral-900 group-hover:text-brand-700 transition-colors">
              {service.name}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-500 line-clamp-2">
              {service.description}
            </p>
            <div class="mt-5 flex items-center gap-1.5 text-sm font-semibold text-brand-600">
              View details
              <Icon name="lucide:arrow-right" class="size-3.5 transition-transform group-hover:translate-x-1.5" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FULL-WIDTH IMAGE BANNER ============ -->
  <section class="relative overflow-hidden w-full">
    <!-- Top fade -->
    <div class="absolute inset-x-0 top-0 z-10 h-16 bg-gradient-to-b from-white to-transparent" />
    <!-- Bottom fade -->
    <div class="absolute inset-x-0 bottom-0 z-10 h-16 bg-gradient-to-t from-white to-transparent" />

    <div class="relative h-64 sm:h-72 lg:h-80 bg-neutral-950">
      <img
        src="/images/performance/uae-performance.webp"
        alt={`Illustrated UAE performance marketing journey connecting paid media, conversion tracking, and qualified leads for businesses in ${area.name}`}
        class="absolute inset-0 h-full w-full object-cover opacity-50"
        width="1920"
        height="500"
        loading="lazy"
      />
      <!-- Violet gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-brand-950/80 via-brand-900/40 to-transparent" />
      <!-- Grid pattern -->
      <div class="absolute inset-0 bg-[linear-gradient(rgba(124,58,237,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(124,58,237,0.05)_1px,transparent_1px)] bg-[size:48px_48px]" />

      <div class="relative mx-auto flex h-full max-w-7xl items-center px-5 lg:px-8">
        <div>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Growing Businesses in {area.name}
          </h2>
          <p class="mt-2 text-base font-medium text-brand-300">
            Local expertise. Data-driven results. Real growth.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHY CHOOSE ============ -->
  <section class="relative overflow-hidden bg-neutral-50 py-24 lg:py-32">
    <!-- Decorative gradient blobs -->
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-40 right-1/4 size-96 rounded-full bg-brand-200/20 blur-[100px]" />
      <div class="absolute -bottom-20 left-1/4 size-80 rounded-full bg-brand-300/15 blur-[80px]" />
    </div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <span class="section-label">
            <Icon name="lucide:shield-check" class="size-3.5" />
            Why CLICKNX
          </span>
          <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl">
            Why Choose CLICKNX<br />in {area.name}?
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-neutral-500">
            {business.name} has been helping businesses in {area.name} and across {area.county} grow through data-driven marketing since {business.foundedYear}.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <div class="flex items-center gap-3 rounded-xl border border-brand-200 bg-white px-5 py-3">
              <Icon name="lucide:check-circle" class="size-5 text-brand-600" />
              <span class="text-sm font-medium text-neutral-700">Free strategy consultation</span>
            </div>
            <div class="flex items-center gap-3 rounded-xl border border-brand-200 bg-white px-5 py-3">
              <Icon name="lucide:check-circle" class="size-5 text-brand-600" />
              <span class="text-sm font-medium text-neutral-700">No long-term contracts</span>
            </div>
          </div>
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
          {[
            { icon: 'lucide:database', title: 'Data-Driven', desc: 'Every campaign decision backed by analytics.' },
            { icon: 'lucide:eye', title: 'Transparent', desc: 'Real-time dashboards and weekly reports.' },
            { icon: 'lucide:zap', title: 'Fast Execution', desc: 'Campaigns live within 48 hours.' },
            { icon: 'lucide:target', title: 'Conversion Focused', desc: 'Optimized for leads and revenue.' },
          ].map((item, i) => (
            <div class={`rounded-2xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:border-brand-200 hover:shadow-lg animate-fade-up stagger-${i + 1}`}>
              <div class="flex size-10 items-center justify-center rounded-xl bg-brand-50 text-brand-600 mb-4">
                <Icon name={item.icon} class="size-5" />
              </div>
              <h3 class="font-display text-base font-semibold text-neutral-900 mb-1">{item.title}</h3>
              <p class="text-sm text-neutral-500">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NEARBY AREAS ============ -->
  {nearbyAreas.length > 0 && (
    <section class="relative overflow-hidden py-24 lg:py-32">
      <!-- Decorative gradient blobs -->
      <div class="pointer-events-none absolute inset-0">
        <div class="absolute top-10 -right-20 size-72 rounded-full bg-brand-100/25 blur-[70px]" />
        <div class="absolute bottom-0 left-1/3 size-56 rounded-full bg-brand-200/15 blur-[50px]" />
      </div>
      <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <span class="section-label">
            <Icon name="lucide:map" class="size-3.5" />
            Coverage Map
          </span>
          <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl">
            Nearby Areas We Serve
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-neutral-500">
            In addition to {area.name}, we also serve these nearby communities across the UAE.
          </p>
        </div>

        <div class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {nearbyAreas.map((nearby, i) => (
            <a
              href={areaUrl(nearby.slug)}
              class={`card-hover group relative rounded-2xl border border-neutral-200 bg-white p-6 transition-all duration-300 animate-fade-up stagger-${i + 1}`}
            >
              <!-- Gradient top border on hover -->
              <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-400 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
              <div class="flex size-11 items-center justify-center rounded-xl bg-gradient-to-br from-brand-50 to-brand-100/60 text-brand-600 mb-5 transition-all duration-300 group-hover:scale-110 group-hover:shadow-md">
                <Icon name="lucide:map-pin" class="size-5" />
              </div>
              <h3 class="font-display text-lg font-semibold text-neutral-900 group-hover:text-brand-700 transition-colors">
                {nearby.name}
              </h3>
              <p class="mt-1 text-sm text-neutral-400">{nearby.county}</p>
              <div class="mt-4 flex items-center gap-1.5 text-sm font-semibold text-brand-600">
                View services
                <Icon name="lucide:arrow-right" class="size-3.5 transition-transform group-hover:translate-x-1.5" />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ TESTIMONIALS ============ -->
  <section class="relative overflow-hidden bg-neutral-50 py-24 lg:py-32">
    <!-- Decorative gradient blobs -->
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-40 left-1/4 size-96 rounded-full bg-brand-200/15 blur-[100px]" />
    </div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <SeoTestimonials area={area} />
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-brand-950 py-24 lg:py-32">
    <!-- Decorative gradient blobs -->
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-40 -right-40 size-[500px] rounded-full bg-brand-600/15 blur-[120px]" />
      <div class="absolute -bottom-20 left-1/4 size-[400px] rounded-full bg-brand-700/10 blur-[100px]" />
      <div class="absolute inset-0 bg-[linear-gradient(rgba(124,58,237,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(124,58,237,0.04)_1px,transparent_1px)] bg-[size:48px_48px]" />
    </div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl">
          Grow Your Business in {area.name}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-brand-200/90 max-w-xl mx-auto">
          {business.name} is a licensed performance marketing agency based in Abu Dhabi, serving businesses across the UAE since {business.foundedYear}.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={contactUrl()}
            class="group inline-flex items-center gap-2.5 rounded-xl bg-white px-7 py-3.5 text-sm font-semibold text-brand-900 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
          >
            Get Your Free Strategy Call
            <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
          </a>
          <a
            href="https://wa.me/971556115985"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2.5 rounded-xl border border-white/20 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur transition-all duration-300 hover:bg-white/10"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp Us
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
