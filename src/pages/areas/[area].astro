---
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../../data/business';
import { serviceTypes } from '../../data/serviceTypes';
import { serviceAreas, getNearbyAreas } from '../../data/serviceAreas';
import { areaUrl, comboUrl, contactUrl } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoTestimonials from '../../components/SeoTestimonials.astro';

import type { ServiceArea } from '../../data/serviceAreas';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { area: area.slug },
    props: { area },
  }));
}

interface Props {
  area: ServiceArea;
}

const { area } = Astro.props;
// getNearbyAreas takes a slug, not the area object.
const nearbyAreas = getNearbyAreas(area.slug);
const years = yearsInBusiness();

const heroStats = [
  { icon: 'lucide:users', value: area.population.toLocaleString('en-US'), label: 'Population' },
  { icon: 'lucide:layers', value: `${serviceTypes.length}`, label: 'Services available' },
  { icon: 'lucide:navigation', value: `${nearbyAreas.length}`, label: 'Nearby areas covered' },
  { icon: 'lucide:award', value: `${years}+`, label: 'Years serving the UAE' },
];

const differentiators = [
  { icon: 'lucide:database', title: 'Data-driven', desc: 'Every campaign decision backed by analytics, not instinct.' },
  { icon: 'lucide:eye', title: 'Transparent', desc: 'Live dashboards and weekly reporting you can audit.' },
  { icon: 'lucide:zap', title: 'Fast execution', desc: 'Campaigns live within 48 hours of strategy sign-off.' },
  { icon: 'lucide:target', title: 'Conversion focused', desc: 'Optimised for leads and revenue, never impressions.' },
];

const pageTitle = `Performance Marketing in ${area.name} | ${business.name}`;
const metaDescription = `Data-driven performance marketing services in ${area.name}, ${area.county}. ${business.name} helps local businesses grow with Google Ads, Meta Ads, CRO, and more.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${business.name} - ${area.name}`,
  description: `${business.name} provides performance marketing services in ${area.name}, ${area.county}, UAE.`,
  url: `${business.siteUrl}/areas/${area.slug}/`,
  email: business.email,
  address: { '@type': 'PostalAddress', addressLocality: area.name, addressCountry: 'AE' },
  geo: { '@type': 'GeoCoordinates', latitude: area.lat, longitude: area.lng },
  areaServed: [
    { '@type': 'City', name: area.name },
    { '@type': 'AdministrativeArea', name: area.county },
  ],
};
---

<BaseLayout title={pageTitle} description={metaDescription} schema={schema}>
  <!-- ============================================================
       1 — HERO
       ============================================================ -->
  <section class="relative overflow-hidden bg-neutral-950 py-24 lg:py-32">
    <div class="lp-grid pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="lp-aurora size-[34rem] -right-32 -top-32 bg-brand-700/30" style="animation-duration:28s"></div>
      <div class="lp-aurora size-[24rem] left-1/4 bottom-[-8rem] bg-cyan-600/12" style="animation-duration:24s;animation-delay:-8s"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <span class="lp-reveal inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-300 backdrop-blur-md">
            <Icon name="lucide:map-pin" class="size-3.5" />
            {area.name}, {area.county}
          </span>

          <h1 class="lp-reveal mt-6 font-display text-[2.6rem] font-semibold leading-[1.05] tracking-tight text-white sm:text-6xl" style="--lp-delay:60ms">
            Performance marketing in <span class="text-brand-400">{area.name}</span>
          </h1>

          <p class="lp-reveal mt-6 max-w-xl text-lg leading-relaxed text-neutral-400" style="--lp-delay:140ms">
            {area.description}
          </p>

          <div class="lp-reveal mt-9 flex flex-col gap-3 sm:flex-row" style="--lp-delay:220ms">
            <a
              href={contactUrl()}
              data-magnetic
              class="lp-magnetic lp-sheen group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-white px-7 py-4 text-sm font-semibold text-neutral-900"
            >
              <span class="lp-sheen-bar"></span>
              Get a free strategy call
              <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
            <a
              href="#services"
              class="inline-flex items-center justify-center gap-2.5 rounded-2xl border border-white/12 bg-white/5 px-7 py-4 text-sm font-semibold text-white backdrop-blur-md transition-all duration-300 hover:border-white/25 hover:bg-white/10"
            >
              View services
            </a>
          </div>
        </div>

        <!-- stats: one brand accent, not four competing ones -->
        <div class="grid grid-cols-2 gap-4">
          {heroStats.map((stat, i) => (
            <div
              class="lp-reveal rounded-2xl border border-white/[0.08] bg-white/[0.03] p-6 backdrop-blur-sm"
              style={`--lp-delay:${i * 80}ms`}
            >
              <span class="flex size-10 items-center justify-center rounded-xl bg-white/[0.06] text-brand-300">
                <Icon name={stat.icon} class="size-5" />
              </span>
              <p class="mt-5 font-display text-2xl font-bold tracking-tight text-white">{stat.value}</p>
              <p class="mt-1 text-xs text-neutral-500">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       2 — SERVICES AVAILABLE HERE
       ============================================================ -->
  <section id="services" class="scroll-mt-24 bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal flex flex-col gap-4 border-b border-neutral-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="flex items-center gap-3">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
            <Icon name="lucide:target" class="size-5" />
          </span>
          <h2 class="font-display text-2xl font-semibold tracking-tight text-neutral-900">
            Services in {area.name}
          </h2>
          <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-[11px] font-semibold text-neutral-500">
            {serviceTypes.length}
          </span>
        </div>
        <p class="text-sm leading-relaxed text-neutral-500">
          Every service is available here, each with campaign strategy and pricing localised to {area.name}.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {serviceTypes.map((service, i) => (
          <a
            href={comboUrl(area.slug, service.slug)}
            class="lp-reveal group flex flex-col rounded-2xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-[0_20px_40px_-24px_rgba(76,29,149,0.35)]"
            style={`--lp-delay:${Math.min(i, 6) * 55}ms`}
          >
            <div class="flex items-start justify-between gap-4">
              <span class="flex size-10 items-center justify-center rounded-xl bg-neutral-900 text-white transition-colors duration-300 group-hover:bg-brand-600">
                <Icon name={`lucide:${service.icon}`} class="size-4.5" />
              </span>
              <Icon
                name="lucide:arrow-up-right"
                class="size-5 shrink-0 text-neutral-300 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-brand-600"
              />
            </div>

            <h3 class="mt-5 font-display text-lg font-semibold tracking-tight text-neutral-900">
              {service.shortName}
            </h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-500 line-clamp-2">
              {service.description}
            </p>
            <p class="mt-5 border-t border-neutral-100 pt-4 text-sm font-semibold text-brand-600">
              {service.shortName} in {area.name}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       3 — IMAGE BANNER
       ============================================================ -->
  <section class="bg-white pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal relative overflow-hidden rounded-[2rem] bg-neutral-950">
        <img
          src="/images/performance/uae-performance.webp"
          alt={`Illustrated UAE performance marketing journey connecting paid media, conversion tracking, and qualified leads for businesses in ${area.name}`}
          class="absolute inset-0 size-full object-cover opacity-60"
          width="1920"
          height="600"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-neutral-950 via-neutral-950/80 to-neutral-950/30"></div>

        <div class="relative flex min-h-[16rem] items-center px-8 py-14 sm:px-12 lg:min-h-[18rem] lg:px-14">
          <div class="max-w-lg">
            <h2 class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Growing businesses in {area.name}
            </h2>
            <p class="mt-3 text-base leading-relaxed text-neutral-300">
              Local search behaviour, local competition, local cost per click. We plan {area.name} on its own numbers
              rather than a national average.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       4 — WHY CLICKNX HERE
       ============================================================ -->
  <section class="border-t border-neutral-200 bg-neutral-50 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
        <div class="lp-reveal">
          <span class="section-label">
            <Icon name="lucide:shield-check" class="size-3.5" />
            Why CLICKNX
          </span>
          <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-[2.75rem]">
            Why businesses in<br /><span class="text-neutral-400">{area.name} choose us</span>
          </h2>
          <p class="mt-5 max-w-md text-lg leading-relaxed text-neutral-500">
            {business.name} has helped businesses across {area.county} grow through data-driven marketing since
            {business.foundedYear}.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            {['Free strategy consultation', 'No long-term contracts'].map((item) => (
              <span class="inline-flex items-center gap-2.5 rounded-xl border border-neutral-200 bg-white px-4 py-2.5 text-sm font-medium text-neutral-700">
                <Icon name="lucide:circle-check" class="size-4 text-brand-600" />
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {differentiators.map((item, i) => (
            <div
              class="lp-reveal rounded-2xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:border-brand-200 hover:shadow-[0_20px_40px_-28px_rgba(76,29,149,0.4)]"
              style={`--lp-delay:${i * 70}ms`}
            >
              <span class="flex size-10 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                <Icon name={item.icon} class="size-5" />
              </span>
              <h3 class="mt-4 font-display text-base font-semibold tracking-tight text-neutral-900">{item.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-neutral-500">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       5 — NEARBY AREAS
       ============================================================ -->
  {nearbyAreas.length > 0 && (
    <section class="bg-white py-24 lg:py-32">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <div class="lp-reveal flex flex-col gap-4 border-b border-neutral-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
          <div class="flex items-center gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name="lucide:map" class="size-5" />
            </span>
            <h2 class="font-display text-2xl font-semibold tracking-tight text-neutral-900">Nearby areas</h2>
          </div>
          <p class="text-sm leading-relaxed text-neutral-500">
            We also serve these locations close to {area.name}.
          </p>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {nearbyAreas.map((nearby, i) => (
            <a
              href={areaUrl(nearby.slug)}
              class="lp-reveal group flex items-center justify-between gap-4 rounded-2xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-[0_20px_40px_-24px_rgba(76,29,149,0.35)]"
              style={`--lp-delay:${i * 70}ms`}
            >
              <span class="flex min-w-0 items-center gap-4">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-neutral-900 text-white transition-colors duration-300 group-hover:bg-brand-600">
                  <Icon name="lucide:map-pin" class="size-4.5" />
                </span>
                <span class="min-w-0">
                  <span class="block font-display text-base font-semibold tracking-tight text-neutral-900 transition-colors duration-300 group-hover:text-brand-700">
                    {nearby.name}
                  </span>
                  <span class="mt-0.5 block truncate text-xs text-neutral-400">{nearby.county}</span>
                </span>
              </span>
              <Icon
                name="lucide:arrow-up-right"
                class="size-4 shrink-0 text-neutral-300 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-brand-600"
              />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============================================================
       6 — TESTIMONIALS
       ============================================================ -->
  <section class="border-t border-neutral-200 bg-neutral-50 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <SeoTestimonials area={area} />
    </div>
  </section>

  <!-- ============================================================
       7 — CTA
       ============================================================ -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal relative overflow-hidden rounded-[2rem] bg-neutral-950 px-8 py-14 sm:px-12 lg:px-14 lg:py-16">
        <div class="pointer-events-none absolute inset-0 overflow-hidden">
          <div class="lp-aurora size-96 -right-24 -top-24 bg-brand-600/25" style="animation-duration:26s"></div>
        </div>

        <div class="relative flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-xl">
            <h2 class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Grow your business in {area.name}
            </h2>
            <p class="mt-4 text-base leading-relaxed text-neutral-400">
              {business.name} is a licensed performance marketing agency based in {business.address.city}, serving
              businesses across the UAE since {business.foundedYear}.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
            <a
              href={contactUrl()}
              data-magnetic
              class="lp-magnetic lp-sheen group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-white px-7 py-4 text-sm font-semibold text-neutral-900"
            >
              <span class="lp-sheen-bar"></span>
              Free strategy call
              <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
            <a
              href="https://wa.me/971566119525"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2.5 rounded-2xl border border-white/12 bg-white/5 px-7 py-4 text-sm font-semibold text-white transition-all duration-300 hover:border-white/25 hover:bg-white/10"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/motion';
</script>
