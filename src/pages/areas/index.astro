---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceAreas, getAreaName } from '../../data/serviceAreas';
import { serviceTypes } from '../../data/serviceTypes';
import { areaUrl, contactUrl } from '../../lib/urls';

// ---------- Coverage figures, all derived from the data ----------
const emirates = [...new Set(serviceAreas.map((area) => area.county))];
const totalPopulation = serviceAreas.reduce((sum, area) => sum + area.population, 0);
const largestPopulation = Math.max(...serviceAreas.map((area) => area.population));

/** 3,600,000 → "3.6M", 350,000 → "350K" */
function compactPopulation(value: number): string {
  if (value >= 1_000_000) {
    const millions = value / 1_000_000;
    return `${millions % 1 === 0 ? millions : millions.toFixed(1)}M`;
  }
  return `${Math.round(value / 1000)}K`;
}

const primaryMarkets = serviceAreas.filter((area) => area.featured);
const otherLocations = serviceAreas.filter((area) => !area.featured);

const coverageStats = [
  { icon: 'lucide:map-pin', value: `${serviceAreas.length}`, label: 'Locations served' },
  { icon: 'lucide:globe', value: `${emirates.length}`, label: 'Emirates covered' },
  { icon: 'lucide:users', value: `${compactPopulation(totalPopulation)}+`, label: 'Combined population' },
  { icon: 'lucide:layers', value: `${serviceTypes.length}`, label: 'Services in each' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Service Areas | ${business.name}`,
  description: `${business.name} provides performance marketing services across the UAE, from Abu Dhabi to Ras Al Khaimah.`,
  url: `${business.siteUrl}/areas/`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: serviceAreas.map((area, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: area.name,
      url: `${business.siteUrl}${areaUrl(area.slug)}`,
    })),
  },
};
---

<BaseLayout
  title={`Service Areas | ${business.name} UAE`}
  description={`${business.name} delivers performance marketing services across the UAE: Abu Dhabi, Dubai, Sharjah, Ajman, Al Ain, Ras Al Khaimah, Fujairah, Umm Al Quwain, Khalifa City, and Yas Island.`}
  schema={schema}
>
  <!-- ============================================================
       1 — HERO · headline with a derived coverage strip
       ============================================================ -->
  <section class="relative overflow-hidden bg-white pb-16 pt-20 lg:pb-20 lg:pt-28">
    <div class="lp-grid-light pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="lp-aurora size-[30rem] -left-32 -top-40 bg-brand-300/20" style="animation-duration:28s"></div>
      <div class="lp-aurora size-[24rem] -right-20 top-10 bg-cyan-300/15" style="animation-duration:24s;animation-delay:-8s"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl">
        <span class="section-label lp-reveal">
          <Icon name="lucide:map-pin" class="size-3.5" />
          UAE coverage
        </span>
        <h1 class="lp-reveal mt-6 font-display text-[2.6rem] font-semibold leading-[1.05] tracking-tight text-neutral-900 sm:text-6xl lg:text-[4rem]" style="--lp-delay:60ms">
          One market, <span class="text-brand-600">seven very different</span> auctions
        </h1>
        <p class="lp-reveal mt-6 max-w-2xl text-lg leading-relaxed text-neutral-500" style="--lp-delay:140ms">
          Search demand, competition and cost per click swing sharply between emirates. We plan and budget for each one
          separately rather than running a single national campaign and hoping.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-neutral-200 bg-neutral-200 lg:grid-cols-4">
        {coverageStats.map((stat, i) => (
          <div class="lp-reveal bg-white px-6 py-7" style={`--lp-delay:${i * 80}ms`}>
            <Icon name={stat.icon} class="size-4 text-brand-500" />
            <p class="mt-4 font-display text-4xl font-bold tracking-tight text-neutral-900">{stat.value}</p>
            <p class="mt-1.5 text-xs text-neutral-500">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       2 — PRIMARY MARKETS · the three biggest, given room
       ============================================================ -->
  <section class="border-t border-neutral-200 bg-neutral-50 py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="font-display text-3xl font-semibold tracking-tight text-neutral-900 sm:text-4xl">
            Primary markets
          </h2>
          <p class="mt-3 max-w-xl text-base leading-relaxed text-neutral-500">
            Where most of our client spend runs, and where the auctions are most competitive.
          </p>
        </div>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {primaryMarkets.map((area, i) => (
          <a
            href={areaUrl(area.slug)}
            class="lp-reveal group flex flex-col rounded-3xl border border-neutral-200 bg-white p-8 transition-all duration-300 hover:-translate-y-1.5 hover:border-brand-200 hover:shadow-[0_28px_60px_-30px_rgba(76,29,149,0.4)]"
            style={`--lp-delay:${i * 90}ms`}
          >
            <div class="flex items-start justify-between gap-4">
              <span class="flex size-12 items-center justify-center rounded-2xl bg-neutral-900 text-white transition-colors duration-300 group-hover:bg-brand-600">
                <Icon name="lucide:map-pin" class="size-5" />
              </span>
              <span class="text-right">
                <span class="block font-display text-2xl font-bold tracking-tight text-neutral-900">
                  {compactPopulation(area.population)}
                </span>
                <span class="block text-[11px] uppercase tracking-wider text-neutral-400">Population</span>
              </span>
            </div>

            <h3 class="mt-6 font-display text-2xl font-semibold tracking-tight text-neutral-900 transition-colors duration-300 group-hover:text-brand-700">
              {area.name}
            </h3>
            <p class="mt-1 text-sm text-neutral-400">{area.county}</p>

            <p class="mt-5 flex-1 text-sm leading-relaxed text-neutral-500">{area.description}</p>

            <span class="mt-7 inline-flex items-center gap-2 border-t border-neutral-100 pt-5 text-sm font-semibold text-brand-600">
              View {area.name} services
              <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       3 — EVERY OTHER LOCATION · compact cards with scale bars
       ============================================================ -->
  <section class="bg-white py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal flex flex-col gap-4 border-b border-neutral-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="font-display text-2xl font-semibold tracking-tight text-neutral-900">
          Also serving
          <span class="ml-1 text-neutral-400">{otherLocations.length}</span>
        </h2>
        <p class="text-sm leading-relaxed text-neutral-500">
          Bars show population relative to {getAreaName('dubai')}, our largest market.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {otherLocations.map((area, i) => (
          <a
            href={areaUrl(area.slug)}
            class="lp-reveal group flex flex-col rounded-2xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-[0_20px_40px_-24px_rgba(76,29,149,0.35)]"
            style={`--lp-delay:${Math.min(i, 6) * 55}ms`}
          >
            <div class="flex items-start justify-between gap-3">
              <span class="min-w-0">
                <span class="block font-display text-lg font-semibold tracking-tight text-neutral-900 transition-colors duration-300 group-hover:text-brand-700">
                  {area.name}
                </span>
                <span class="mt-0.5 block truncate text-xs text-neutral-400">{area.county}</span>
              </span>
              <Icon
                name="lucide:arrow-up-right"
                class="size-4 shrink-0 text-neutral-300 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-brand-600"
              />
            </div>

            <!-- population scale, relative to the largest market -->
            <div class="mt-5">
              <div class="flex items-baseline justify-between text-xs">
                <span class="font-semibold text-neutral-700">{compactPopulation(area.population)}</span>
                <span class="text-neutral-400">population</span>
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-neutral-100">
                <div
                  class="h-full rounded-full bg-gradient-to-r from-brand-500 to-brand-400"
                  style={`width:${Math.max((area.population / largestPopulation) * 100, 3)}%`}
                >
                </div>
              </div>
            </div>

            {area.nearby.length > 0 && (
              <div class="mt-5 border-t border-neutral-100 pt-4">
                <p class="text-[11px] uppercase tracking-wider text-neutral-400">Near</p>
                <p class="mt-1.5 text-xs leading-relaxed text-neutral-500">
                  {area.nearby.map((slug) => getAreaName(slug)).join(' · ')}
                </p>
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       4 — CTA · same offer everywhere
       ============================================================ -->
  <section class="bg-white pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal relative overflow-hidden rounded-[2rem] bg-neutral-950 px-8 py-14 sm:px-12 lg:px-14 lg:py-16">
        <div class="pointer-events-none absolute inset-0 overflow-hidden">
          <div class="lp-aurora size-96 -right-24 -top-24 bg-brand-600/25" style="animation-duration:26s"></div>
        </div>

        <div class="relative flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-xl">
            <h2 class="font-display text-3xl font-semibold tracking-tight text-white sm:text-4xl">
              Not seeing your city?
            </h2>
            <p class="mt-4 text-base leading-relaxed text-neutral-400">
              We run campaigns across all {emirates.length} emirates, not only the {serviceAreas.length} locations listed
              here. Tell us where you operate and we will confirm coverage.
            </p>
          </div>

          <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
            <a
              href={contactUrl()}
              data-magnetic
              class="lp-magnetic lp-sheen group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-white px-7 py-4 text-sm font-semibold text-neutral-900"
            >
              <span class="lp-sheen-bar"></span>
              Get in touch
              <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
            <a
              href={`mailto:${business.email}`}
              class="inline-flex items-center justify-center gap-2.5 rounded-2xl border border-white/12 bg-white/5 px-7 py-4 text-sm font-semibold text-white transition-all duration-300 hover:border-white/25 hover:bg-white/10"
            >
              <Icon name="lucide:mail" class="size-4 text-brand-300" />
              {business.email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/motion';
</script>
