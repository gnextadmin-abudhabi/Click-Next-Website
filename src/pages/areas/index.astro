---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceAreas } from '../../data/serviceAreas';
import { areaUrl, contactUrl } from '../../lib/urls';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Service Areas | ${business.name}`,
  description: `${business.name} provides performance marketing services across the UAE, from Abu Dhabi to Ras Al Khaimah.`,
  url: `${business.siteUrl}/areas/`,
};
---

<BaseLayout
  title={`Service Areas | ${business.name} UAE`}
  description={`${business.name} delivers performance marketing services across the UAE: Abu Dhabi, Dubai, Sharjah, Ajman, Al Ain, Ras Al Khaimah, Fujairah, Umm Al Quwain, Khalifa City, and Yas Island.`}
  schema={schema}
>
  <Breadcrumbs crumbs={[{ label: 'Areas We Serve' }]} />

  <!-- ============ HEADER ============ -->
  <section class="py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <span class="section-label">
          <Icon name="lucide:map-pin" class="size-3.5" />
          UAE Coverage
        </span>
        <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight text-neutral-900 sm:text-6xl">
          Performance Marketing<br />Across the UAE
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-neutral-500">
          From Abu Dhabi to Ras Al Khaimah, CLICKNX delivers data-driven marketing campaigns to businesses in every emirate. Local expertise, measurable results.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ AREAS GRID ============ -->
  <section class="pb-20 lg:pb-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {serviceAreas.map((area, i) => (
          <a
            href={areaUrl(area.slug)}
            class={`card-hover group rounded-2xl border border-neutral-200 bg-white p-7 transition-all duration-300 animate-fade-up stagger-${Math.min(i + 1, 6)}`}
          >
            <div class="flex size-11 items-center justify-center rounded-xl bg-gradient-to-br from-brand-50 to-brand-100/60 text-brand-600 mb-5 transition-all duration-300 group-hover:scale-110 group-hover:shadow-md group-hover:shadow-brand-200/50">
              <Icon name="lucide:map-pin" class="size-5" />
            </div>
            <h2 class="font-display text-lg font-semibold text-neutral-900 group-hover:text-brand-700 transition-colors">
              {area.name}
            </h2>
            <p class="mt-1 text-sm text-neutral-400">{area.county}</p>
            <p class="mt-4 line-clamp-2 text-sm leading-relaxed text-neutral-500">
              {area.description}
            </p>
            <div class="mt-5 flex items-center gap-1.5 text-sm font-semibold text-brand-600">
              View services
              <Icon name="lucide:arrow-right" class="size-3.5 transition-transform group-hover:translate-x-1.5" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-brand-900 py-20 lg:py-28">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-20 -right-20 size-64 rounded-full bg-brand-700/20 blur-3xl" />
    </div>
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl">
          Not Sure If We Cover Your Area?
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-brand-200/90 max-w-xl mx-auto">
          We serve businesses across all seven emirates. If your city is not listed above, reach out and we will let you know.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={contactUrl()}
            class="group inline-flex items-center gap-2.5 rounded-xl bg-white px-7 py-3.5 text-sm font-semibold text-brand-900 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
          >
            Get in Touch
            <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
          </a>
          <a
            href={`mailto:${business.email}`}
            class="inline-flex items-center gap-2.5 rounded-xl border border-white/20 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur transition-all duration-300 hover:bg-white/10"
          >
            {business.email}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
