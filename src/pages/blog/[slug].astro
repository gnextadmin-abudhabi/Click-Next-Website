---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogUrl, contactUrl } from '../../lib/urls';
import { business } from '../../data/business';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const categoryColors: Record<string, { bg: string; text: string }> = {
  'paid-ads': { bg: 'bg-brand-100', text: 'text-brand-700' },
  'cro': { bg: 'bg-green-100', text: 'text-green-700' },
  'analytics': { bg: 'bg-blue-100', text: 'text-blue-700' },
  'social-media': { bg: 'bg-pink-100', text: 'text-pink-700' },
  'strategy': { bg: 'bg-amber-100', text: 'text-amber-700' },
  'news': { bg: 'bg-stone-200', text: 'text-stone-700' },
};

const colors = categoryColors[post.data.category] || categoryColors.news;

function formatDate(iso: string): string {
  const date = new Date(iso + 'T00:00:00');
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate,
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: business.siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: business.name,
    url: business.siteUrl,
    email: business.email,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${business.siteUrl}${blogUrl(post.id)}`,
  },
};
---

<BaseLayout
  title={`${post.data.title} | ${business.name}`}
  description={post.data.description}
  canonicalUrl={`${business.siteUrl}${blogUrl(post.id)}`}
  schema={schema}
>
  <article class="mx-auto max-w-3xl px-5 py-14 lg:px-8 lg:py-20">
    <header class="pb-8">
      <div class="flex flex-wrap items-center gap-3">
        <span class={`inline-block rounded-full px-3 py-1 text-xs font-semibold capitalize ${colors.bg} ${colors.text}`}>
          {post.data.category.replace('-', ' ')}
        </span>
        {post.data.readingTime && (
          <span class="flex items-center gap-1 text-xs text-stone-400">
            <Icon name="lucide:clock" class="size-3" />
            {post.data.readingTime}
          </span>
        )}
      </div>

      <h1 class="mt-4 font-display text-3xl text-brand-950 sm:text-4xl">
        {post.data.title}
      </h1>

      <div class="mt-4 flex items-center gap-3 text-sm text-stone-500">
        <div class="flex items-center gap-1.5">
          <Icon name="lucide:calendar" class="size-4" />
          <time datetime={post.data.publishDate}>
            {formatDate(post.data.publishDate)}
          </time>
        </div>
        <span class="text-stone-300">|</span>
        <div class="flex items-center gap-1.5">
          <Icon name="lucide:user" class="size-4" />
          <span>{post.data.author}</span>
        </div>
      </div>

      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="rounded-full border border-stone-200 bg-stone-50 px-3 py-1 text-xs text-stone-500">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose-editorial">
      <Content />
    </div>

    <!-- CTA -->
    <div class="mt-12 rounded-xl bg-gradient-to-br from-brand-900 to-brand-800 p-8 lg:p-10 relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0">
        <div class="absolute -top-10 -right-10 size-32 rounded-full bg-brand-700/20 blur-xl" />
      </div>
      <div class="relative">
        <h2 class="font-display text-xl text-white">
          Ready to Put These Strategies into Action?
        </h2>
        <p class="mt-2 text-sm text-brand-200">
          Let CLICKNX build a custom performance marketing strategy for your business. Free consultation, no commitment.
        </p>
        <div class="mt-5 flex flex-wrap gap-4">
          <a
            href={contactUrl()}
            class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-brand-900 shadow transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
          >
            Get a Free Strategy Call
            <Icon name="lucide:arrow-right" class="size-4" />
          </a>
          <a
            href={`mailto:${business.email}`}
            class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/5 px-5 py-2.5 text-sm font-semibold text-white backdrop-blur transition-all duration-300 hover:bg-white/10"
          >
            {business.email}
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
