---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceTypes, getServiceBySlug } from '../../data/serviceTypes';
import type { ServiceType } from '../../data/serviceTypes';
import { serviceUrl, contactUrl } from '../../lib/urls';

/** "From AED 1,000/month" — keeps the per-unit suffix when the tier has one. */
function priceFrom(service: ServiceType): string | null {
  const tier = service.priceRanges[0];
  if (!tier) return null;
  const suffix = tier.unit?.includes('/') ? `/${tier.unit.split('/')[1]}` : '';
  return `From AED ${tier.min.toLocaleString('en-US')}${suffix}`;
}

// ---------- Services grouped into three readable families ----------
const categories = [
  {
    key: 'paid-media',
    title: 'Paid media',
    icon: 'lucide:target',
    blurb: 'Campaigns on the platforms where your customers already spend their attention, managed to a cost-per-outcome target.',
    slugs: ['google-ads-management', 'meta-ads', 'tiktok-ads', 'linkedin-ads', 'programmatic-advertising'],
  },
  {
    key: 'conversion',
    title: 'Conversion',
    icon: 'lucide:mouse-pointer-click',
    blurb: 'The pages and experiments that turn paid traffic into booked business instead of bounced sessions.',
    slugs: ['landing-page-design', 'conversion-rate-optimization'],
  },
  {
    key: 'measurement',
    title: 'Measurement & organic',
    icon: 'lucide:activity',
    blurb: 'The tracking layer that proves what worked, and the owned presence that compounds alongside paid.',
    slugs: ['analytics-tracking', 'social-media-marketing'],
  },
].map((category) => ({
  ...category,
  services: category.slugs
    .map((slug) => getServiceBySlug(slug))
    .filter((service): service is ServiceType => service !== undefined),
}));

// Safety net: surface anything not assigned to a category above.
const grouped = new Set(categories.flatMap((c) => c.slugs));
const ungrouped = serviceTypes.filter((s) => !grouped.has(s.slug));
if (ungrouped.length) {
  categories.push({
    key: 'more',
    title: 'More services',
    icon: 'lucide:layers',
    blurb: 'Additional performance services available on request.',
    slugs: ungrouped.map((s) => s.slug),
    services: ungrouped,
  });
}

// ---------- What every engagement includes ----------
const inclusions = [
  { icon: 'lucide:users', title: 'A named strategist', body: 'One person accountable for your account — not a rotating pool.' },
  { icon: 'lucide:zap', title: 'Launch in 48 hours', body: 'Campaigns live within two days of strategy sign-off.' },
  { icon: 'lucide:gauge', title: 'A live dashboard', body: 'Looker Studio reporting you can open any day of the week.' },
  { icon: 'lucide:database', title: 'Full tracking setup', body: 'GA4, GTM and platform pixels configured and verified.' },
  { icon: 'lucide:eye', title: 'Accounts in your name', body: 'You own the ad accounts, the pixels and the data. Always.' },
  { icon: 'lucide:shield-check', title: 'No lock-in contract', body: 'Month to month. We keep the work by earning it.' },
];

// ---------- Pricing model (tier bands come straight from the service data) ----------
const tiers = [
  { name: 'Starter', spend: 'Up to AED 10K monthly ad spend', body: 'A single primary channel, one landing page and core conversion tracking. Built for proving the model before scaling it.' },
  { name: 'Growth', spend: 'AED 10K – 50K monthly ad spend', body: 'Multi-channel campaigns, a structured testing roadmap and ongoing CRO. The band most of our clients sit in.', featured: true },
  { name: 'Enterprise', spend: 'AED 50K+ monthly ad spend', body: 'Full-funnel media, programmatic inventory, advanced attribution and dedicated reporting infrastructure.' },
];

const lowestStarter = Math.min(...serviceTypes.map((s) => s.priceRanges[0]?.min ?? Infinity));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Services | ${business.name}`,
  description: `Complete range of performance marketing services from ${business.name}: Google Ads, Meta Ads, CRO, analytics, social media, TikTok, LinkedIn, programmatic advertising, and landing page design.`,
  url: `${business.siteUrl}/services/`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: serviceTypes.map((service, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: service.name,
      url: `${business.siteUrl}${serviceUrl(service.slug)}`,
    })),
  },
};
---

<BaseLayout
  title={`Performance Marketing Services | ${business.name} Abu Dhabi`}
  description={`${business.name} offers a full range of performance marketing services across the UAE: Google Ads, Meta Ads, CRO, analytics, social media, TikTok, LinkedIn, programmatic advertising, and landing page design.`}
  schema={schema}
>
  <!-- ============================================================
       1 — HERO · calm, typographic, no competing imagery
       ============================================================ -->
  <section class="relative overflow-hidden bg-white pb-16 pt-20 lg:pb-20 lg:pt-28">
    <div class="lp-grid-light pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="lp-aurora size-[30rem] -left-32 -top-40 bg-brand-300/20" style="animation-duration:28s"></div>
      <div class="lp-aurora size-[24rem] -right-20 top-0 bg-cyan-300/15" style="animation-duration:24s;animation-delay:-8s"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl">
        <span class="section-label lp-reveal">
          <Icon name="lucide:layers" class="size-3.5" />
          {serviceTypes.length} services
        </span>
        <h1 class="lp-reveal mt-6 font-display text-[2.6rem] font-semibold leading-[1.05] tracking-tight text-neutral-900 sm:text-6xl lg:text-[4rem]" style="--lp-delay:60ms">
          Services that drive <span class="text-brand-600">revenue</span>
        </h1>
        <p class="lp-reveal mt-6 max-w-2xl text-lg leading-relaxed text-neutral-500" style="--lp-delay:140ms">
          From paid search to conversion optimisation, every service is built to produce a measurable business result.
          No vanity metrics — just the numbers your accountant recognises.
        </p>
      </div>

      <!-- jump links -->
      <nav class="lp-reveal mt-10 flex flex-wrap gap-2.5" style="--lp-delay:220ms" aria-label="Service categories">
        {categories.map((category) => (
          <a
            href={`#${category.key}`}
            class="group inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-white px-4 py-2.5 text-sm font-medium text-neutral-700 transition-all duration-300 hover:border-brand-300 hover:text-brand-700"
          >
            <Icon name={category.icon} class="size-4 text-brand-500" />
            {category.title}
            <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] font-semibold text-neutral-500 transition-colors group-hover:bg-brand-50 group-hover:text-brand-600">
              {category.services.length}
            </span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ============================================================
       2 — SERVICES · grouped by family, uniform compact cards
       ============================================================ -->
  <section class="bg-white pb-8">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      {categories.map((category) => (
        <div id={category.key} class="scroll-mt-28 py-14 lg:py-16">
          <!-- category header spans the full width, so no column sits empty -->
          <div class="lp-reveal border-b border-neutral-200 pb-6">
            <div class="flex items-center gap-3">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
                <Icon name={category.icon} class="size-5" />
              </span>
              <h2 class="font-display text-2xl font-semibold tracking-tight text-neutral-900">{category.title}</h2>
              <span class="rounded-full bg-neutral-100 px-2.5 py-1 text-[11px] font-semibold text-neutral-500">
                {category.services.length}
              </span>
            </div>
            <!-- unconstrained width so it sits on a single line on desktop -->
            <p class="mt-3 text-sm leading-relaxed text-neutral-500">{category.blurb}</p>
          </div>

          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {category.services.map((service, i) => (
              <a
                href={serviceUrl(service.slug)}
                class="lp-reveal group flex flex-col rounded-2xl border border-neutral-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-[0_20px_40px_-24px_rgba(76,29,149,0.35)]"
                style={`--lp-delay:${i * 60}ms`}
              >
                <div class="flex items-start justify-between gap-4">
                  <span class="flex size-10 items-center justify-center rounded-xl bg-neutral-900 text-white transition-colors duration-300 group-hover:bg-brand-600">
                    <Icon name={`lucide:${service.icon}`} class="size-4.5" />
                  </span>
                  <Icon
                    name="lucide:arrow-up-right"
                    class="size-5 shrink-0 text-neutral-300 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-brand-600"
                  />
                </div>

                <h3 class="mt-5 font-display text-lg font-semibold tracking-tight text-neutral-900">
                  {service.name}
                </h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-neutral-500 line-clamp-3">
                  {service.description}
                </p>

                {priceFrom(service) && (
                  <p class="mt-5 border-t border-neutral-100 pt-4 text-sm font-semibold text-brand-600">
                    {priceFrom(service)}
                  </p>
                )}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============================================================
       3 — INCLUDED · checklist beside the ecosystem visual
       ============================================================ -->
  <section class="bg-neutral-50 py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
        <div class="lp-reveal order-2 overflow-hidden rounded-3xl border border-neutral-200 bg-neutral-950 lg:order-1">
          <img
            src="/images/performance/services-ecosystem.webp"
            alt="Illustrated paid media ecosystem connecting advertising channels, creative, landing pages, analytics, and conversion optimisation"
            class="aspect-[4/3] w-full object-cover"
            width="1200"
            height="900"
            loading="lazy"
          />
        </div>

        <div class="order-1 lg:order-2">
          <div class="lp-reveal">
            <span class="section-label">
              <Icon name="lucide:circle-check" class="size-3.5" />
              Every engagement
            </span>
            <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-[2.75rem]">
              What you get,<br /><span class="text-neutral-400">whichever service you pick.</span>
            </h2>
          </div>

          <dl class="mt-10 grid gap-x-8 gap-y-7 sm:grid-cols-2">
            {inclusions.map((item, i) => (
              <div class="lp-reveal" style={`--lp-delay:${i * 60}ms`}>
                <dt class="flex items-center gap-2.5 font-display text-base font-semibold text-neutral-900">
                  <Icon name={item.icon} class="size-4 shrink-0 text-brand-500" />
                  {item.title}
                </dt>
                <dd class="mt-1.5 text-sm leading-relaxed text-neutral-500">{item.body}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       4 — PRICING MODEL · three bands, no invented numbers
       ============================================================ -->
  <section class="relative overflow-hidden bg-neutral-950 py-24 lg:py-32">
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal mx-auto max-w-2xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-300">
          <Icon name="lucide:wallet" class="size-3.5" />
          How pricing works
        </span>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl">
          Fees scale with spend
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-400">
          Management fees are tied to the size and complexity of the account, not to a fixed package. Retainers start at
          AED {lowestStarter.toLocaleString('en-US')} per month.
        </p>
      </div>

      <div class="mt-14 grid gap-5 lg:grid-cols-3">
        {tiers.map((tier, i) => (
          <div
            class={`lp-reveal flex flex-col rounded-3xl border p-8 ${tier.featured ? 'border-brand-400/30 bg-brand-500/[0.06]' : 'border-white/[0.08] bg-white/[0.03]'}`}
            style={`--lp-delay:${i * 90}ms`}
          >
            <div class="flex items-center justify-between gap-4">
              <h3 class="font-display text-xl font-semibold tracking-tight text-white">{tier.name}</h3>
              {tier.featured && (
                <span class="rounded-full bg-brand-500/15 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-brand-300 ring-1 ring-brand-400/25">
                  Most common
                </span>
              )}
            </div>
            <p class="mt-2 text-sm font-medium text-brand-300">{tier.spend}</p>
            <p class="mt-5 flex-1 text-sm leading-relaxed text-neutral-400">{tier.body}</p>
          </div>
        ))}
      </div>

      <p class="lp-reveal mt-8 text-center text-sm text-neutral-500">
        Every engagement is quoted after the audit, once we know what the account actually needs.
      </p>
    </div>
  </section>

  <!-- ============================================================
       5 — CTA
       ============================================================ -->
  <section class="bg-white py-24 lg:py-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal rounded-[2rem] border border-neutral-200 bg-neutral-50 px-8 py-14 text-center sm:px-14 lg:py-16">
        <h2 class="font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl">
          Not sure where to start?
        </h2>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-neutral-500">
          Book a free audit. We will look at your accounts, tracking and landing pages, then tell you which of these
          services would actually move your number — and which would not.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={contactUrl()}
            data-magnetic
            class="lp-magnetic lp-sheen group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-neutral-900 px-7 py-4 text-sm font-semibold text-white shadow-[0_18px_40px_-20px_rgba(23,23,23,0.8)]"
          >
            <span class="lp-sheen-bar"></span>
            Get a free audit
            <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
          </a>
          <a
            href={business.phoneHref}
            class="inline-flex items-center justify-center gap-2.5 rounded-2xl border border-neutral-200 bg-white px-7 py-4 text-sm font-semibold text-neutral-700 transition-all duration-300 hover:border-neutral-400 hover:text-neutral-900"
          >
            <Icon name="lucide:phone" class="size-4 text-brand-500" />
            {business.phone}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/motion';
</script>
