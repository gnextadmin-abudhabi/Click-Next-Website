---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { business, yearsInBusiness } from '../data/business';
import { serviceAreas } from '../data/serviceAreas';
import { serviceTypes } from '../data/serviceTypes';
import { areaUrl, contactUrl } from '../lib/urls';

const years = yearsInBusiness();

// ---------- Hero spec sheet ----------
const specSheet = [
  { label: 'Founded', value: String(business.foundedYear) },
  { label: 'Head office', value: `${business.address.city}, UAE` },
  { label: 'Parent group', value: 'GNEXT Group' },
  { label: 'Discipline', value: 'Paid media, CRO & analytics' },
  { label: 'Coverage', value: 'All seven emirates' },
];

const heroFacts = [
  { value: 15, suffix: '+', label: 'Years in UAE digital', icon: 'lucide:history' },
  { value: 282, suffix: '+', label: 'Group projects delivered', icon: 'lucide:briefcase' },
  { value: serviceTypes.length, suffix: '', label: 'Performance specialisms', icon: 'lucide:layers' },
  { value: serviceAreas.length, suffix: '', label: 'Locations served', icon: 'lucide:map-pin' },
];

// ---------- Timeline ----------
const milestones = [
  {
    tag: 'Roots',
    icon: 'lucide:anchor',
    title: 'Fifteen years inside Abu Dhabi’s digital scene',
    body: 'GNEXT was building websites, search visibility and digital tooling for UAE businesses long before performance marketing became a line item on anyone’s budget. That accumulated market knowledge is the foundation everything here sits on.',
  },
  {
    tag: 'Scale',
    icon: 'lucide:layers',
    title: '282+ projects, and one recurring gap',
    body: 'Across hundreds of builds the same pattern kept surfacing. Clients had a site that worked and traffic that did not convert — and nobody was accountable for the number at the end of the funnel.',
  },
  {
    tag: String(business.foundedYear),
    icon: 'lucide:rocket',
    title: 'CLICKNX is founded to close it',
    body: 'A dedicated performance division, deliberately separated from the web business. One remit: paid media, conversion and measurement, judged on revenue rather than reach.',
  },
  {
    tag: 'Today',
    icon: 'lucide:crosshair',
    title: `${serviceTypes.length} specialisms across ${serviceAreas.length} locations`,
    body: 'Google, Meta, TikTok and LinkedIn campaigns wired to conversion-built landing pages and full GA4 instrumentation — running for clients from Abu Dhabi to Ras Al Khaimah.',
  },
];

// ---------- GNEXT Group ----------
const groupCompanies = [
  {
    key: 'gnext',
    name: 'GNEXT',
    tag: 'The website solution company',
    icon: 'lucide:globe',
    url: 'https://GNEXT.ae/',
    urlLabel: 'GNEXT.ae',
    current: false,
    blurb:
      'Web design, development, SEO and AI solutions for UAE businesses. GNEXT builds the platform your marketing runs on — fast, indexable and structured for growth.',
    points: ['Web design & development', 'Technical & on-page SEO', 'AI solutions and automation'],
    stat: { value: '282+', label: 'Projects delivered' },
  },
  {
    key: 'clicknx',
    name: 'CLICKNX',
    tag: 'Performance marketing',
    icon: 'lucide:target',
    url: null,
    urlLabel: null,
    current: true,
    blurb:
      'The performance arm of the group. Paid advertising, conversion rate optimisation, landing pages and the measurement layer that ties every click to a business outcome.',
    points: ['Google, Meta, TikTok & LinkedIn ads', 'CRO and landing page builds', 'GA4, GTM and attribution'],
    stat: { value: `${serviceTypes.length}`, label: 'Specialist services' },
  },
  {
    key: 'gxlocate',
    name: 'GXLOCATE',
    tag: 'Local intelligence',
    icon: 'lucide:map-pin',
    url: 'https://GXLOCATE.com/',
    urlLabel: 'GXLOCATE.com',
    current: false,
    blurb:
      'Google Business Profile optimisation and local search intelligence. GXLOCATE handles the map pack, the reviews and the local signals that paid media alone cannot buy.',
    points: ['Google Business Profile management', 'Local ranking & review strategy', 'Multi-location listings'],
    stat: { value: '7', label: 'Emirates covered' },
  },
];

// ---------- Operating principles ----------
const principles = [
  {
    title: 'Evidence over opinion',
    body: 'Every recommendation traces back to a number in your account — a query report, a test result, an attribution path. If we cannot show you the evidence, we do not make the claim.',
  },
  {
    title: 'You own everything',
    body: 'The ad accounts, the pixels, the analytics property and the data are yours and stay yours. No locked platforms, no proxy accounts, no leverage held over a relationship.',
  },
  {
    title: 'Speed is a feature',
    body: 'Campaigns go live within 48 hours of strategy sign-off. Landing pages are built in-house, so creative, copy and page never sit waiting on a third party.',
  },
  {
    title: 'Structure survives growth',
    body: 'Account architecture, naming conventions and budget guardrails are designed to hold at AED 5,000 a month and still hold at AED 500,000. Rebuilds are expensive; we avoid them.',
  },
  {
    title: 'Local nuance is not a garnish',
    body: 'Arabic and English consumer behaviour, platform habits, Ramadan and summer seasonality, emirate-by-emirate competition. We work in this market, so we plan around it.',
  },
  {
    title: 'Conversions, not vanity metrics',
    body: 'Impressions and reach do not appear in our reporting unless they explain a conversion. Campaigns are built around leads, sales and appointments — the numbers your accountant recognises.',
  },
];

// ---------- Credentials ----------
const credentials = [
  ...business.certifications.map((name) => ({ name, note: 'Verified platform partner status' })),
  { name: business.license, note: `Registered and operating from ${business.address.city}` },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About ${business.name}`,
  description: business.description,
  url: `${business.siteUrl}/about/`,
  mainEntity: {
    '@type': 'ProfessionalService',
    name: business.name,
    description: business.description,
    foundingDate: `${business.foundedYear}`,
    address: { '@type': 'PostalAddress', addressLocality: business.address.city, addressCountry: 'AE' },
  },
};
---

<BaseLayout
  title={`About ${business.name} | Performance Marketing Agency Abu Dhabi`}
  description={`Learn about ${business.name}, the performance marketing arm of the GNEXT Group. ${years}+ years delivering data-driven paid media, CRO and analytics across the UAE.`}
  schema={schema}
>
  <!-- ============================================================
       1 — HERO · editorial split with a spec sheet
       ============================================================ -->
  <section class="relative overflow-hidden bg-white pb-16 pt-6 lg:pb-24">
    <div class="lp-grid-light pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="lp-aurora size-[34rem] -left-40 -top-40 bg-brand-300/25" style="animation-duration:28s"></div>
      <div class="lp-aurora size-[26rem] -right-24 top-20 bg-cyan-300/20" style="animation-duration:22s;animation-delay:-7s"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid items-end gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <span class="section-label lp-reveal">
            <Icon name="lucide:info" class="size-3.5" />
            About CLICKNX
          </span>

          <h1 class="mt-6 font-display text-[2.6rem] font-semibold leading-[1.04] tracking-tight text-neutral-900 sm:text-6xl lg:text-[4.25rem]">
            <span class="lp-reveal block" style="--lp-delay:60ms">Marketing you can</span>
            <span class="lp-reveal block text-brand-600" style="--lp-delay:150ms">audit line by line.</span>
          </h1>

          <p class="lp-reveal mt-7 max-w-xl text-lg leading-relaxed text-neutral-500" style="--lp-delay:240ms">
            CLICKNX is the performance marketing arm of the GNEXT Group, built in {business.foundedYear} around a single
            idea: if a campaign cannot be traced to revenue, it is not a campaign — it is an expense.
          </p>

          <div class="lp-reveal mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" style="--lp-delay:320ms">
            <a
              href={contactUrl()}
              data-magnetic
              class="lp-magnetic lp-sheen group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-neutral-900 px-7 py-4 text-sm font-semibold text-white shadow-[0_18px_40px_-20px_rgba(23,23,23,0.8)]"
            >
              <span class="lp-sheen-bar"></span>
              Talk to the team
              <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
            </a>
            <a
              href="#ab-group"
              class="inline-flex items-center justify-center gap-2.5 rounded-2xl border border-neutral-200 bg-white px-7 py-4 text-sm font-semibold text-neutral-700 transition-all duration-300 hover:border-neutral-400 hover:text-neutral-900"
            >
              <Icon name="lucide:network" class="size-4 text-brand-500" />
              Meet the GNEXT Group
            </a>
          </div>
        </div>

        <!-- spec sheet -->
        <div class="lp-reveal lp-reveal-xr lg:col-span-5" style="--lp-delay:200ms">
          <dl class="overflow-hidden rounded-3xl border border-neutral-200 bg-white/80 shadow-[0_24px_60px_-40px_rgba(76,29,149,0.5)] backdrop-blur-sm">
            <div class="flex items-center gap-2.5 border-b border-neutral-100 px-6 py-4">
              <span class="lp-live flex size-2 rounded-full bg-emerald-500 text-emerald-500"></span>
              <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-neutral-400">Company profile</span>
            </div>
            {specSheet.map((row, i) => (
              <div
                class={`flex items-baseline justify-between gap-6 px-6 py-4 ${i < specSheet.length - 1 ? 'border-b border-neutral-100' : ''}`}
              >
                <dt class="shrink-0 text-xs font-medium uppercase tracking-wider text-neutral-400">{row.label}</dt>
                <dd class="text-right font-display text-sm font-semibold text-neutral-900">{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- fact strip -->
      <div class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-neutral-200 bg-neutral-200 lg:grid-cols-4">
        {heroFacts.map((fact, i) => (
          <div class="lp-reveal bg-white px-6 py-7" style={`--lp-delay:${i * 80}ms`}>
            <Icon name={fact.icon} class="size-4 text-brand-500" />
            <p class="mt-4 font-display text-4xl font-bold tracking-tight text-neutral-900">
              <span class="lp-count" data-count={fact.value} data-decimals="0">0</span>{fact.suffix}
            </p>
            <p class="mt-1.5 text-xs text-neutral-500">{fact.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       2 — TIMELINE · centre-line milestones
       ============================================================ -->
  <section class="relative overflow-hidden bg-neutral-50 py-24 lg:py-32">
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal mx-auto max-w-2xl text-center">
        <span class="section-label">
          <Icon name="lucide:milestone" class="size-3.5" />
          Our story
        </span>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl">
          How we got here
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-500">
          CLICKNX did not start from zero. It started from fifteen years of watching what actually moves the number.
        </p>
      </div>

      <div class="relative mt-16 lg:mt-20">
        <!-- the spine: left on mobile, centred on desktop -->
        <div
          class="pointer-events-none absolute inset-y-0 left-[15px] w-px bg-gradient-to-b from-transparent via-brand-300 to-transparent lg:left-1/2 lg:-translate-x-1/2"
        >
        </div>

        <ol class="space-y-10 lg:space-y-14">
          {milestones.map((m, i) => (
            <li class="lp-reveal relative pl-12 lg:grid lg:grid-cols-2 lg:gap-16 lg:pl-0" style={`--lp-delay:${i * 90}ms`}>
              <!-- node -->
              <span
                class="absolute left-0 top-1 flex size-8 items-center justify-center rounded-full border border-brand-200 bg-white text-brand-600 shadow-sm lg:left-1/2 lg:-translate-x-1/2"
              >
                <Icon name={m.icon} class="size-4" />
              </span>

              <div class={i % 2 === 0 ? 'lg:col-start-1 lg:pr-4 lg:text-right' : 'lg:col-start-2 lg:pl-4'}>
                <span class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-700 ring-1 ring-brand-100">
                  {m.tag}
                </span>
                <h3 class="mt-4 font-display text-xl font-semibold tracking-tight text-neutral-900 sm:text-2xl">
                  {m.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-neutral-500">{m.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============================================================
       3 — GNEXT GROUP · three equal company cards
       ============================================================ -->
  <section id="ab-group" class="relative overflow-hidden bg-neutral-950 py-24 lg:py-32">
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal mx-auto max-w-2xl text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-300">
          <Icon name="lucide:network" class="size-3.5" />
          The group
        </span>
        <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl">
          One vision, three companies
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-neutral-400">
          Each company in the GNEXT Group owns one part of digital growth, so you get a specialist rather than a
          generalist stretched thin.
        </p>
      </div>

      <div class="mt-14 grid gap-5 lg:grid-cols-3">
        {groupCompanies.map((c, i) => (
          <article
            class={`lp-reveal flex flex-col rounded-3xl border p-7 ${c.current ? 'border-brand-400/30 bg-brand-500/[0.06]' : 'border-white/[0.08] bg-white/[0.03]'}`}
            style={`--lp-delay:${i * 90}ms`}
          >
            <div class="flex items-center justify-between gap-4">
              <span
                class={`flex size-12 items-center justify-center rounded-2xl ${c.current ? 'bg-gradient-to-br from-brand-500 to-brand-700 text-white' : 'bg-white/[0.06] text-neutral-300'}`}
              >
                <Icon name={c.icon} class="size-5" />
              </span>
              {c.current && (
                <span class="rounded-full bg-brand-500/15 px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-brand-300 ring-1 ring-brand-400/25">
                  You are here
                </span>
              )}
            </div>

            <h3 class="mt-6 font-display text-2xl font-semibold tracking-tight text-white">{c.name}</h3>
            <p class="mt-1 text-xs uppercase tracking-wider text-neutral-500">{c.tag}</p>

            <p class="mt-5 text-sm leading-relaxed text-neutral-400">{c.blurb}</p>

            <ul class="mt-6 space-y-2.5">
              {c.points.map((point) => (
                <li class="flex items-start gap-2.5 text-sm text-neutral-400">
                  <Icon name="lucide:circle-check" class="mt-0.5 size-4 shrink-0 text-brand-400" />
                  {point}
                </li>
              ))}
            </ul>

            <div class="mt-8 flex items-end justify-between gap-4 border-t border-white/[0.08] pt-6">
              <div>
                <p class="font-display text-3xl font-bold tracking-tight text-white">{c.stat.value}</p>
                <p class="mt-0.5 text-[11px] uppercase tracking-wider text-neutral-500">{c.stat.label}</p>
              </div>
              {c.url ? (
                <a
                  href={c.url}
                  target="_blank"
                  rel="noopener"
                  class="group inline-flex items-center gap-1.5 text-sm font-semibold text-white transition-colors hover:text-brand-300"
                >
                  {c.urlLabel}
                  <Icon name="lucide:arrow-up-right" class="size-4 transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                </a>
              ) : (
                <a
                  href="/services/"
                  class="group inline-flex items-center gap-1.5 text-sm font-semibold text-brand-300 transition-colors hover:text-white"
                >
                  Our services
                  <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-1" />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       4 — PRINCIPLES · numbered index rows
       ============================================================ -->
  <!-- No `overflow-hidden` here: it would become the sticky scroll container
       and pin the heading in place instead of letting it track the list. -->
  <section class="relative bg-white py-24 lg:py-32">
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <div class="lp-reveal lg:sticky lg:top-28">
            <span class="section-label">
              <Icon name="lucide:compass" class="size-3.5" />
              How we operate
            </span>
            <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl">
              Six rules we<br /><span class="text-neutral-400">do not bend.</span>
            </h2>
            <p class="mt-5 text-base leading-relaxed text-neutral-500">
              These are not values on a wall. They are the constraints we work inside, and the ones you should hold us to.
            </p>
          </div>
        </div>

        <ol class="lg:col-span-8">
          {principles.map((p, i) => (
            <li
              class="lp-reveal group relative border-t border-neutral-200 last:border-b"
              style={`--lp-delay:${i * 60}ms`}
            >
              <span class="absolute inset-y-0 left-0 w-0.5 origin-top scale-y-0 bg-brand-500 transition-transform duration-500 group-hover:scale-y-100"></span>
              <div class="flex gap-5 py-7 transition-[padding] duration-500 group-hover:pl-5 sm:gap-8">
                <span class="pt-0.5 font-display text-sm font-bold tabular-nums text-neutral-300 transition-colors duration-300 group-hover:text-brand-500">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-display text-xl font-semibold tracking-tight text-neutral-900 sm:text-2xl">
                    {p.title}
                  </h3>
                  <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-neutral-500">{p.body}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============================================================
       5 — CREDENTIALS · dark split
       ============================================================ -->
  <section class="relative overflow-hidden bg-neutral-950 py-24 lg:py-32">
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="lp-aurora size-[30rem] right-[-8rem] bottom-0 bg-cyan-600/15" style="animation-duration:26s"></div>
      <div class="lp-aurora size-[26rem] left-1/4 -top-24 bg-brand-700/20" style="animation-duration:32s;animation-delay:-9s"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
        <div class="lp-reveal">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-brand-300 backdrop-blur-md">
            <Icon name="lucide:badge-check" class="size-3.5" />
            Credentials
          </span>
          <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl">
            Verifiable,<br /><span class="text-neutral-600">not self-declared.</span>
          </h2>
          <p class="mt-5 max-w-md text-lg leading-relaxed text-neutral-400">
            Platform partnerships are earned against spend thresholds and certification exams, and a trade licence is a
            matter of public record. Every badge below is something you can check independently.
          </p>

          <a
            href={contactUrl()}
            class="mt-9 inline-flex items-center gap-2.5 rounded-2xl border border-white/12 bg-white/5 px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:border-white/25 hover:bg-white/10"
          >
            Request our credentials pack
            <Icon name="lucide:arrow-right" class="size-4" />
          </a>
        </div>

        <ul class="lp-reveal lp-reveal-xr space-y-3" style="--lp-delay:120ms">
          {credentials.map((cred, i) => (
            <li
              class="lp-spot flex items-center gap-4 rounded-2xl border border-white/[0.08] bg-white/[0.03] p-5 transition-colors duration-300 hover:border-white/15"
              style={`--lp-delay:${i * 70}ms`}
            >
              <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white shadow-lg shadow-brand-900/40">
                <Icon name="lucide:badge-check" class="size-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-display text-sm font-semibold text-white">{cred.name}</span>
                <span class="mt-0.5 block text-xs text-neutral-500">{cred.note}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================================================
       6 — COVERAGE · editorial link rows
       ============================================================ -->
  <section class="relative overflow-hidden bg-neutral-50 py-24 lg:py-32">
    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="lp-reveal flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-xl">
          <span class="section-label">
            <Icon name="lucide:map-pin" class="size-3.5" />
            Where we work
          </span>
          <h2 class="mt-5 font-display text-4xl font-semibold tracking-tight text-neutral-900 sm:text-5xl">
            Across every emirate
          </h2>
        </div>
        <p class="max-w-xs text-sm leading-relaxed text-neutral-500">
          Search behaviour, competition and cost per click differ sharply between emirates. We plan for each one
          separately.
        </p>
      </div>

      <div class="mt-14 grid gap-x-12 sm:grid-cols-2">
        {serviceAreas.map((area, i) => (
          <a
            href={areaUrl(area.slug)}
            class="lp-reveal group flex items-center justify-between gap-4 border-t border-neutral-200 py-5 transition-[padding] duration-300 last:border-b hover:pl-3 sm:last:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b"
            style={`--lp-delay:${Math.min(i, 8) * 45}ms`}
          >
            <span class="min-w-0">
              <span class="block font-display text-lg font-semibold tracking-tight text-neutral-900 transition-colors duration-300 group-hover:text-brand-700">
                {area.name}
              </span>
              <span class="mt-0.5 block truncate text-xs text-neutral-400">{area.county}</span>
            </span>
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-neutral-200 text-neutral-400 transition-all duration-300 group-hover:border-brand-300 group-hover:bg-brand-50 group-hover:text-brand-600">
              <Icon name="lucide:arrow-up-right" class="size-4" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       7 — CTA · split with contact details
       ============================================================ -->
  <section class="relative overflow-hidden bg-white py-24 lg:py-32">
    <div class="lp-grid-light pointer-events-none absolute inset-0"></div>

    <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
      <div class="overflow-hidden rounded-[2rem] border border-neutral-200 bg-neutral-950 shadow-[0_40px_90px_-50px_rgba(76,29,149,0.7)]">
        <div class="grid lg:grid-cols-2">
          <!-- pitch -->
